{% comment %}
    دعوة مرتبطة بموضوع المقال — تُدرَج في قالبَي المقال (post وpost-feature).
    الفكرة: القارئ الذي وصل إلى آخر المقال يعمل على موضوع قريب منه،
    فتُعرض عليه الخدمة المناسبة لموضوعه لا خدمة عامة.
    الهدف الأساسي: جلسة التشخيص (خطوة صغيرة)، والثانوي: صفحة الخدمات.
{% endcomment %}
{%- assign cta_cat = page.categories | first | default: page.category -%}
{%- assign cta_kicker = 'خدمة مرتبطة بهذا المقال' -%}
{%- assign cta_title = 'هل تحتاج مرافقة في بحثك؟' -%}
{%- assign cta_text = 'من ضبط الإشكالية إلى ملف جاهز للنشر: منهج، مصادر، توثيق، وخرائط. والمسؤولية العلمية تبقى لصاحب البحث.' -%}

{%- case cta_cat -%}
    {%- when 'تاريخ-الماء' -%}
        {%- assign cta_title = 'هل تعمل على الماء والمدينة؟' -%}
        {%- assign cta_text = 'أُعدّ الخرائط التاريخية، وأقرأ الوثائق والأرشيف، وأضبط الفصل الذي يربط التقنية بالعمران.' -%}
    {%- when 'الموارد-المائية', 'الموارد المائية' -%}
        {%- assign cta_title = 'أرقام الماء تحتاج توثيقاً' -%}
        {%- assign cta_text = 'تحويل المعطيات والجداول إلى فصل مكتوب موثّق، مع خرائط وملفات مصدر قابلة للتحديث.' -%}
    {%- when 'التاريخ-البيئي' -%}
        {%- assign cta_title = 'الجفاف والمناخ في بحثك؟' -%}
        {%- assign cta_text = 'بناء الإطار التاريخي للأزمة المناخية: من المصادر والوثائق إلى الجداول والخرائط.' -%}
    {%- when 'الحرف-التقليدية' -%}
        {%- assign cta_title = 'حرفة تدرسها وتبحث عن مادتها؟' -%}
        {%- assign cta_text = 'جمع المادة الميدانية والأرشيفية وتوثيقها، ثم تحويلها إلى نص قابل للنشر.' -%}
    {%- when 'التراث-الثقافي' -%}
        {%- assign cta_title = 'ملف تراثي يحتاج محتوى علمياً؟' -%}
        {%- assign cta_text = 'تحرير المحتوى العلمي لملفات التعريف والمعارض والمسارات، مع التوثيق والمراجع.' -%}
    {%- when 'التاريخ-الاقتصادي' -%}
        {%- assign cta_title = 'الاقتصاد القديم يحتاج أرقاماً ومصادر' -%}
        {%- assign cta_text = 'قراءة الوثائق الاقتصادية، وبناء السلاسل والأسعار، وتقديمها في نص موثّق.' -%}
    {%- when 'الدراسات-الدينية' -%}
        {%- assign cta_title = 'نصوص وتراجم تحتاج ضبطاً' -%}
        {%- assign cta_text = 'تفريغ النصوص القديمة وضبط الأعلام والمصطلحات، مع حواشٍ توضيحية.' -%}
    {%- when 'جغرافيا-تاريخية' -%}
        {%- assign cta_title = 'قراءة المجال تحتاج خرائط' -%}
        {%- assign cta_text = 'خرائط تاريخية مبنية على المصادر، تُسلَّم مع بياناتها وملفاتها الأصلية.' -%}
    {%- when 'دراسات-فكرية' -%}
        {%- assign cta_title = 'نص فكري يحتاج تحريراً دقيقاً' -%}
        {%- assign cta_text = 'مراجعة منهجية ولغوية، وتوحيد المصطلحات والمراجع وفق نمط المجلة.' -%}
{%- endcase -%}

<aside class="ed-cta">
    <p class="ed-cta-eyebrow">{{ cta_kicker }}</p>
    <h2 class="ed-cta-title">{{ cta_title }}</h2>
    <p class="ed-cta-text">{{ cta_text }}</p>
    <div class="ed-cta-actions">
        <a class="ed-cta-btn" href="{{ '/consultation/' | relative_url }}" data-cta="consultation">احجز جلسة تشخيص <i class="fas fa-arrow-left" aria-hidden="true"></i></a>
        <a class="ed-cta-btn ghost" href="{{ '/services/' | relative_url }}" data-cta="services">الخدمات والباقات</a>
    </div>
</aside>
