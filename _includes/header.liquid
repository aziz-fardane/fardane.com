<header class="site-header relative z-50" data-controller="header">
    <div class="site-shell">
        <div class="site-header-bar">
            <a href="{{ '/' | relative_url }}" class="site-mark">
                <span class="site-mark-initial">د.</span>
                <span class="site-mark-name">عزيز فردان</span>
            </a>

            <nav class="site-nav" aria-label="التنقل الرئيسي">
                <ul>
                    <li><a href="{{ '/' | relative_url }}" class="site-nav-link"><span>الرئيسية</span><div class="site-nav-rule w-0"></div></a></li>
                    <li><a href="{{ '/articles/' | relative_url }}" class="site-nav-link"><span>أبحاث ومقالات</span><div class="site-nav-rule w-0"></div></a></li>
                    <li><a href="{{ '/scientists/' | relative_url }}" class="site-nav-link"><span>شخصيات تاريخية</span><div class="site-nav-rule w-0"></div></a></li>
                    <li><a href="{{ '/manuscripts/' | relative_url }}" class="site-nav-link"><span>المخطوطات</span><div class="site-nav-rule w-0"></div></a></li>
                    <li><a href="{{ '/services/' | relative_url }}" class="site-nav-link"><span>الخدمات</span><div class="site-nav-rule w-0"></div></a></li>
                    <li><a href="{{ '/about/' | relative_url }}" class="site-nav-link"><span>السيرة الذاتية</span><div class="site-nav-rule w-0"></div></a></li>
                </ul>
