        <div class="site-mobile invisible opacity-0 -translate-y-full transition-all duration-500" data-header-target="mobileMenu">
            <div class="site-shell site-mobile-body">
                <button type="button" class="site-mobile-close" data-action="click->header#closeMenu" aria-label="إغلاق القائمة">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>

                <nav aria-label="التنقل الرئيسي — الجوال">
                    <ul class="site-mobile-list">
                        <li><a href="{{ '/' | relative_url }}" data-action="click->header#closeMenu"><span class="site-mobile-num">01</span><span>الرئيسية</span></a></li>
                        <li><a href="{{ '/articles/' | relative_url }}" data-action="click->header#closeMenu"><span class="site-mobile-num">02</span><span>أبحاث ومقالات</span></a></li>
                        <li><a href="{{ '/scientists/' | relative_url }}" data-action="click->header#closeMenu"><span class="site-mobile-num">03</span><span>شخصيات تاريخية</span></a></li>
                        <li><a href="{{ '/manuscripts/' | relative_url }}" data-action="click->header#closeMenu"><span class="site-mobile-num">04</span><span>المخطوطات</span></a></li>
                        <li><a href="{{ '/services/' | relative_url }}" data-action="click->header#closeMenu"><span class="site-mobile-num">05</span><span>الخدمات</span></a></li>
