@import "tailwindcss";
@import "./article.pcss";
@import "./articles-index.pcss";

/* Minimal custom styles that can't be handled with Tailwind alone */
@media (prefers-reduced-motion: no-preference) {
    html {
        scroll-behavior: smooth;
    }
}

/* For RTL text alignment */
.rtl {
    direction: rtl;
}

/* RTL specific fixes */
.rtl\:space-x-reverse {
    --tw-space-x-reverse: 1 !important;
}

html[dir="rtl"] .space-x-4,
html[dir="rtl"] .space-x-8,
html[dir="rtl"] .space-x-12 {
    --tw-space-x-reverse: 1 !important;
}

/* Ensure proper RTL support for Flexbox */
@media (prefers-reduced-motion: no-preference) {
    .transition-all {
        transition-property: all;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
}

/* Global focus styles */
*:focus-visible {
    @apply outline-none ring-2 ring-amber-500 ring-offset-2;
}

/* Refinements for Arabic text */
body {
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* Remove default focus outline and use custom one */
:focus {
    outline: none;
}

:focus-visible {
    @apply ring-2 ring-amber-500;
}

/* Simple preloader animation */
@keyframes spin {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}

.animate-spin {
    animation: spin 1s linear infinite;
}

/* Custom animation utilities */
@keyframes pulse-slow {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 0.7;
    transform: scale(1.05);
  }
}

.animate-pulse-slow {
  animation: pulse-slow 3s ease-in-out infinite;
}

/* Special text reveal animation classes */
.text-reveal, .text-reveal-delayed, .text-reveal-slower {
  opacity: 0;
  transform: translateY(20px);
}

/* Special transforms */
.transform-gpu {
  transform: translateZ(0);
  backface-visibility: hidden;
}

/* Enhanced backdrop blur utilities */
.backdrop-blur-xs {
  backdrop-filter: blur(2px);
}

.backdrop-blur-xl {
  backdrop-filter: blur(24px);
}

/* Additional utility classes */
.hover\:scale-102:hover {
  transform: scale(1.02);
}

.hover\:scale-103:hover {
  transform: scale(1.03);
}

.-z-1 {
  z-index: -1;
}

.-z-4 {
  z-index: -4;
}

.-z-5 {
  z-index: -5;
}

/* Water animation specific styles */
#waterCanvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: -10;
}

/* Direction-aware hover effect */
.direction-aware-hover {
  position: relative;
  overflow: hidden;
}

.direction-aware-hover::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(120deg, rgba(194, 145, 12, 0.3), rgba(120, 53, 15, 0.1));
  opacity: 0;
  transform: translateY(100%);
  transition: transform 0.6s ease-out, opacity 0.6s ease-out;
  z-index: -1;
}

.direction-aware-hover:hover::after {
  opacity: 1;
  transform: translateY(0);
}

/* Utility for disabling animation on user preference */
@media (prefers-reduced-motion: reduce) {
    * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}


/* --------------------------------------------------------------------------
   Newsletter band (above the footer) — shown only when site.newsletter_action
   is configured. Falls back to nothing, so no dead form is ever rendered.
   -------------------------------------------------------------------------- */
.nl-band {
    padding: clamp(2.6rem, 5vw, 4rem) 0;
    background: #f3f0e7;
    border-top: 1px solid #ded7c5;
    color: #131f1b;
    font-family: 'Noto Naskh Arabic', serif;
}

.nl-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2rem;
    align-items: center;
    width: min(1120px, 100% - 2.4rem);
    margin-inline: auto;
}

.nl-code {
    margin: 0 0 0.8rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.22em;
    color: #8f6524;
}

.nl-title {
    margin: 0;
    font-family: 'Noto Kufi Arabic', sans-serif;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    line-height: 1.4;
    color: #131f1b;
}

.nl-text {
    max-width: 46ch;
    margin: 0.6rem 0 0;
    font-size: 0.88rem;
    line-height: 1.9;
    color: #6f6a5c;
}

.nl-form {
    margin: 0;
}

.nl-label {
    display: block;
    margin-bottom: 0.45rem;
    font-family: 'Noto Kufi Arabic', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    color: #2c3833;
}

.nl-row {
    display: flex;
    gap: 0.5rem;
}

.nl-input {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 1rem;
    border: 1px solid #cfc6b0;
    background: #faf8f2;
    color: #131f1b;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
}

.nl-input::placeholder {
    color: #9a9284;
}

.nl-input:focus {
    outline: none;
    border-color: #8f6524;
    box-shadow: 0 0 0 2px rgba(166, 122, 46, 0.18);
}

.nl-btn {
    flex: 0 0 auto;
    padding: 0.8rem 1.4rem;
    border: 0;
    background: #8f6524;
    color: #fbf7ec;
    font-family: 'Noto Kufi Arabic', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease;
}

.nl-btn:hover {
    background: #2e6f68;
}

.nl-note {
    margin: 0.55rem 0 0;
    font-size: 0.7rem;
    color: #6f6a5c;
}

.nl-ok {
    margin: 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line-strong, #cfc6b0);
    border-inline-start: 3px solid var(--water, #2e6f68);
    background: var(--paper-2, #faf8f2);
    font-size: 0.86rem;
    line-height: 1.8;
    color: var(--ink, #131f1b);
}

@media (max-width: 820px) {
    .nl-inner {
        grid-template-columns: 1fr;
        gap: 1.4rem;
    }
}

@media (max-width: 480px) {
    .nl-row {
        flex-direction: column;
    }

    .nl-btn {
        width: 100%;
    }
}

/* Optional print styles for better printing */
@media print {
    body {
        @apply text-black bg-white;
    }

    /* Hide unnecessary elements when printing */
    header, footer, #back-to-top, #preloader {
        display: none !important;
    }

    /* Ensure all text is visible */
    p, h1, h2, h3, h4, h5, h6 {
        color: black !important;
        break-inside: avoid;
    }

    a {
        text-decoration: underline;
        color: black !important;
    }

    /* Add page breaks where appropriate */
    section {
        break-inside: avoid;
    }
}
