/* ==========================================================================
   Articles index — "فهرس الأبحاث"
   Paper, brass and ink identity shared with the home page.
   All layout rules are logical so the English edition mirrors correctly.
   ========================================================================== */

.ar-root {
    --paper: #f3f0e7;
    --paper-2: #faf8f2;
    --ink: #131f1b;
    --graphite: #2c3833;
    --muted: #6f6a5c;
    --brass: #a67a2e;
    --brass-text: #8f6524;
    --brass-2: #c9a35f;
    --water: #2e6f68;
    --night: #0b1c17;
    --line: #ded7c5;
    --line-strong: #cfc6b0;
    --naskh: "Noto Naskh Arabic", serif;
    --kufi: "Noto Kufi Arabic", sans-serif;
    --mono: "IBM Plex Mono", monospace;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--naskh);
    background-image:
        linear-gradient(to left, rgba(19, 31, 27, 0.045) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(19, 31, 27, 0.045) 1px, transparent 1px);
    background-size: 96px 96px;
}

.ar-root *,
.ar-root *::before,
.ar-root *::after {
    box-sizing: border-box;
}

.ar-wrap {
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(1.15rem, 4vw, 2rem);
}

/* --------------------------------------------------------------------------
   Hero
   -------------------------------------------------------------------------- */
.ar-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line-strong);
    background: linear-gradient(to bottom, var(--paper-2), var(--paper));
}

.ar-hero::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: 0;
    width: min(46%, 540px);
    pointer-events: none;
    opacity: 0.6;
    background-image:
        repeating-radial-gradient(circle at 8% 88%, transparent 0 30px, rgba(166, 122, 46, 0.28) 30px 31px),
        repeating-radial-gradient(circle at 46% 12%, transparent 0 40px, rgba(46, 111, 104, 0.18) 40px 41px);
    -webkit-mask-image: linear-gradient(to right, #000, transparent 94%);
    mask-image: linear-gradient(to right, #000, transparent 94%);
}

.ar-hero-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.6rem, 6vw, 4.4rem) clamp(2rem, 4vw, 3rem);
}

.ar-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass-text);
}

.ar-kicker::before {
    content: "";
    width: 34px;
    height: 1px;
    background: var(--brass-2);
}

.ar-title {
    margin: 0;
    font-family: var(--naskh);
    font-weight: 700;
    font-size: clamp(2.1rem, 5.4vw, 3.7rem);
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
}

.ar-title span {
    color: var(--brass-text);
}

.ar-lede {
    max-width: 62ch;
    margin: 1rem 0 0;
    font-size: clamp(0.98rem, 1.4vw, 1.12rem);
    line-height: 2;
    color: var(--muted);
}

.ar-lede b {
    color: var(--ink);
    font-weight: 600;
}

/* Search */
.ar-search {
    position: relative;
    max-width: 620px;
    margin-top: 1.9rem;
}

.ar-search input {
    width: 100%;
    padding: 0.95rem 3.1rem 0.95rem 1.1rem;
    border: 1px solid var(--line-strong);
    background: var(--paper-2);
    color: var(--ink);
    font-family: var(--naskh);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.ar-search input::placeholder {
    color: #9a9382;
}

.ar-search input:focus {
    border-color: var(--brass);
    box-shadow: 0 0 0 3px rgba(166, 122, 46, 0.14);
}

.ar-search button {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    border: 0;
    background: transparent;
    color: var(--brass-text);
    cursor: pointer;
}

.ar-search button:hover {
    color: var(--water);
}

/* --------------------------------------------------------------------------
   Layout
   -------------------------------------------------------------------------- */
.ar-main {
    padding-block: clamp(2.2rem, 5vw, 3.6rem) clamp(3rem, 6vw, 5rem);
}

.ar-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
}

@media (min-width: 1024px) {
    .ar-grid {
        grid-template-columns: minmax(0, 1fr) 320px;
    }
}

.ar-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 2px solid var(--ink);
}

.ar-section-title {
    margin: 0;
    font-family: var(--naskh);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink);
}

.ar-section-code {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass-text);
    white-space: nowrap;
}

.ar-count {
    font-family: var(--kufi);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--muted);
}

/* --------------------------------------------------------------------------
   Article records
   -------------------------------------------------------------------------- */
.ar-list {
    display: flex;
    flex-direction: column;
}

.ar-item {
    display: grid;
    grid-template-columns: 3.2rem 190px minmax(0, 1fr);
    gap: clamp(1rem, 2.4vw, 1.6rem);
    padding-block: clamp(1.4rem, 3vw, 1.9rem);
    border-bottom: 1px solid var(--line);
    align-items: start;
}

.ar-num {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--brass-text);
    padding-top: 0.35rem;
}

.ar-thumb {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--paper-2);
}

.ar-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
}

.ar-item:hover .ar-thumb img {
    transform: scale(1.045);
}

.ar-item-body {
    min-width: 0;
}

.ar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 0.6rem;
    padding: 0;
    list-style: none;
}

.ar-tags a {
    display: inline-block;
    padding: 0.18rem 0.55rem;
    border: 1px solid var(--line);
    background: var(--paper-2);
    font-family: var(--kufi);
    font-size: 0.6rem;
    font-weight: 600;
    color: #5d5748;
    text-decoration: none;
    transition: border-color 0.18s ease, color 0.18s ease;
}

.ar-tags a:hover {
    border-color: var(--brass);
    color: var(--brass-text);
}

.ar-item-title {
    margin: 0;
    font-family: var(--naskh);
    font-size: clamp(1.15rem, 2.2vw, 1.42rem);
    font-weight: 700;
    line-height: 1.55;
    color: var(--ink);
}

.ar-item-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
}

.ar-item-title a:hover {
    color: var(--brass-text);
}

.ar-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    margin-top: 0.55rem;
    font-family: var(--kufi);
    font-size: 0.66rem;
    color: var(--muted);
}

.ar-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}

.ar-meta i {
    color: var(--brass);
    font-size: 0.62rem;
}

.ar-excerpt {
    margin: 0.65rem 0 0;
    font-size: 0.9rem;
    line-height: 1.95;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.ar-read {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.85rem;
    font-family: var(--kufi);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--brass-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.18s ease, border-color 0.18s ease, gap 0.18s ease;
}

.ar-read:hover {
    color: var(--water);
    border-color: var(--water);
    gap: 0.7rem;
}

/* --------------------------------------------------------------------------
   Pagination
   -------------------------------------------------------------------------- */
.ar-pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: clamp(2rem, 4vw, 3rem);
}

.ar-pager a,
.ar-pager span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.4rem;
    height: 2.4rem;
    padding-inline: 0.6rem;
    border: 1px solid var(--line-strong);
    background: var(--paper-2);
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--graphite);
    text-decoration: none;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
}

.ar-pager a:hover {
    border-color: var(--brass);
    color: var(--brass-text);
}

.ar-pager .is-current {
    background: var(--ink);
    border-color: var(--ink);
    color: #f7f3e8;
}

.ar-pager .is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

/* --------------------------------------------------------------------------
   Sidebar
   -------------------------------------------------------------------------- */
.ar-side {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
}

.ar-card {
    border: 1px solid var(--line-strong);
    background: var(--paper-2);
    padding: 1.15rem 1.2rem 1.25rem;
}

.ar-card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0 0 0.9rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--kufi);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--brass-text);
}

.ar-card-title i {
    color: var(--brass);
    font-size: 0.7rem;
}

.ar-author {
    text-align: center;
}

.ar-author img {
    display: block;
    width: 84px;
    height: 84px;
    margin: 0 auto 0.7rem;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    padding: 3px;
    background: var(--paper);
}

.ar-author-name {
    margin: 0;
    font-family: var(--naskh);
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--ink);
}

.ar-author-role {
    margin: 0.25rem 0 0;
    font-family: var(--kufi);
    font-size: 0.66rem;
    line-height: 1.8;
    color: var(--muted);
}

.ar-author-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.7rem;
    font-family: var(--kufi);
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--water);
    text-decoration: none;
}

.ar-author-link:hover {
    text-decoration: underline;
}

.ar-cats,
.ar-latest,
.ar-taglist {
    margin: 0;
    padding: 0;
    list-style: none;
}

.ar-cats li + li {
    border-top: 1px dashed var(--line);
}

.ar-cats a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding-block: 0.5rem;
    font-family: var(--kufi);
    font-size: 0.7rem;
    color: var(--graphite);
    text-decoration: none;
    transition: color 0.18s ease;
}

.ar-cats a:hover {
    color: var(--brass-text);
}

.ar-cats b {
    min-width: 1.6rem;
    padding: 0.12rem 0.4rem;
    border: 1px solid var(--line);
    background: var(--paper);
    font-family: var(--mono);
    font-size: 0.62rem;
    font-weight: 400;
    color: var(--muted);
    text-align: center;
}

.ar-taglist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
}

.ar-taglist a {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--line);
    background: var(--paper);
    font-family: var(--kufi);
    font-size: 0.62rem;
    color: #5d5748;
    text-decoration: none;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
}

.ar-taglist a:hover {
    border-color: var(--brass);
    color: var(--brass-text);
    background: #f4efe2;
}

.ar-latest li + li {
    margin-top: 0.8rem;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--line);
}

.ar-latest a {
    display: flex;
    gap: 0.7rem;
    text-decoration: none;
}

.ar-latest-thumb {
    flex: 0 0 60px;
    width: 60px;
    height: 60px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--paper);
}

.ar-latest-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.ar-latest a:hover .ar-latest-thumb img {
    transform: scale(1.06);
}

.ar-latest-title {
    margin: 0;
    font-family: var(--naskh);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--graphite);
    transition: color 0.18s ease;
}

.ar-latest a:hover .ar-latest-title {
    color: var(--brass-text);
}

.ar-latest-date {
    margin: 0.2rem 0 0;
    font-family: var(--kufi);
    font-size: 0.6rem;
    color: var(--muted);
}

.ar-uni {
    text-align: center;
    background: linear-gradient(to bottom, #f6f1e3, var(--paper-2));
}

.ar-uni img {
    display: block;
    width: 88px;
    height: 88px;
    margin: 0 auto 0.7rem;
    object-fit: contain;
}

.ar-uni h3 {
    margin: 0;
    font-family: var(--naskh);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
}

.ar-uni a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-family: var(--kufi);
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--water);
    text-decoration: none;
}

.ar-uni a:hover {
    text-decoration: underline;
}

/* --------------------------------------------------------------------------
   Responsive
   -------------------------------------------------------------------------- */
@media (max-width: 1023px) {
    .ar-side {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 760px) {
    .ar-item {
        grid-template-columns: 1fr;
        gap: 0.9rem;
    }

    .ar-num {
        display: none;
    }

    .ar-thumb {
        aspect-ratio: 16 / 9;
    }

    .ar-side {
        grid-template-columns: minmax(0, 1fr);
    }

    .ar-section-head {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
    }
}

/* --------------------------------------------------------------------------
   Site chrome around the index
   -------------------------------------------------------------------------- */
body.articles-page {
    background: #f3f0e7;
}

body.articles-page #preloader {
    background: #f3f0e7;
}

body.articles-page header > div.absolute {
    background: #f3f0e7 !important;
    box-shadow: none !important;
    border-bottom: 1px solid #cfc6b0;
}

body.articles-page header .bg-white {
    background: #f3f0e7 !important;
}

body.articles-page header .text-stone-900,
body.articles-page header .text-stone-800 {
    color: #131f1b !important;
}

body.articles-page header .text-stone-700 {
    color: #3b463f !important;
}

body.articles-page header .text-amber-600 {
    color: #8f6524 !important;
}

body.articles-page header .hover\:text-amber-700:hover {
    color: #2e6f68 !important;
}

body.articles-page header .bg-amber-600 {
    background: #8f6524 !important;
}

body.articles-page header .bg-amber-100 {
    background: #e4ede9 !important;
}

body.articles-page footer.bg-stone-900 {
    background: #0b1c17 !important;
    border-top: 1px solid rgba(201, 163, 95, 0.28);
}

body.articles-page footer .text-amber-400,
body.articles-page footer .text-amber-500,
body.articles-page footer .text-amber-600 {
    color: #c9a35f !important;
}

body.articles-page footer .text-stone-300 {
    color: #c9bea6 !important;
}

body.articles-page footer .text-stone-400 {
    color: #a8a08d !important;
}

body.articles-page footer .text-stone-500 {
    color: #918a79 !important;
}

body.articles-page footer .border-stone-700 {
    border-color: rgba(201, 163, 95, 0.22) !important;
}

body.articles-page #back-to-top {
    background: #2e6f68 !important;
}

@media (prefers-reduced-motion: reduce) {
    .ar-root *,
    .ar-root *::before,
    .ar-root *::after {
        transition: none !important;
        animation: none !important;
    }
}
