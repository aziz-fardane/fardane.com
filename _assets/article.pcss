/* ==========================================================================
   Article redesign — two editorial directions (no JavaScript required)
   Used by the local preview at /_assets/redesign.pcss
   Design A: "دفتر الباحث" — warm paper, single reading column, chronicle
   Design B: "الملف الأكاديمي" — cool white, sticky dossier sidebar
   All layout rules use logical properties so the English (LTR) edition
   mirrors the Arabic (RTL) edition automatically.
   ========================================================================== */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
}

body {
    margin: 0;
}

h1, h2, h3, h4, h5, h6,
p, ul, ol, figure, blockquote, table {
    margin: 0;
}

img {
    max-width: 100%;
}

/* --------------------------------------------------------------------------
   Design tokens
   -------------------------------------------------------------------------- */
:root {
    --font-body: "Noto Naskh Arabic", "Spectral", Georgia, "Times New Roman", serif;
    --font-display: "Noto Kufi Arabic", "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
    --font-latin: "Spectral", Georgia, "Times New Roman", serif;
    --font-latin-display: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
    --radius: 2px;
}

html[dir="ltr"] {
    --font-body: "Spectral", Georgia, "Times New Roman", serif;
    --font-display: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
}

.design-a {
    --paper: #f6f1e6;
    --surface: #fbf8f1;
    --ink: #241f19;
    --ink-soft: #3f3830;
    --muted: #7a7062;
    --line: #dcd1bd;
    --line-soft: #e9e1d1;
    --accent: #8a5a2b;
    --accent-soft: #efe4d0;
    --accent-ink: #6f4520;
    --radius: 2px;
    background: var(--paper);
}

.design-b {
    --paper: #f2f5f2;
    --surface: #ffffff;
    --ink: #1c2420;
    --ink-soft: #3a4641;
    --muted: #6a7772;
    --line: #dfe6e1;
    --line-soft: #edf1ee;
    --accent: #14603f;
    --accent-soft: #eaf3ed;
    --accent-ink: #0f4a31;
    --radius: 12px;
    background: var(--paper);
}

/* --------------------------------------------------------------------------
   Shared shell
   -------------------------------------------------------------------------- */
.ed-root {
    background: var(--paper);
    color: var(--ink-soft);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    min-height: 100vh;
}

.ed-container {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: clamp(1.1rem, 4vw, 2.5rem);
}

.ed-sitebar {
    background: var(--surface);
    border-bottom: 1px solid var(--line-soft);
}

.design-b .ed-sitebar {
    border-top: 4px solid var(--accent);
}

.ed-sitebar-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.85rem;
}

.ed-logo {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 800;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
}

.ed-logo span {
    color: var(--accent);
}

.ed-nav {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    margin-inline-start: auto;
}

.ed-nav a {
    font-family: var(--font-display);
    font-size: 0.74rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.18s ease;
}

.ed-nav a:hover {
    color: var(--accent);
}

.ed-lang {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.34rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.18s ease, border-color 0.18s ease;
}

.ed-lang:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
}

@media (max-width: 760px) {
    .ed-nav {
        display: none;
    }

    .ed-lang {
        margin-inline-start: auto;
    }
}

/* --------------------------------------------------------------------------
   Hero
   -------------------------------------------------------------------------- */
.ed-hero-inner {
    max-width: 980px;
}

.design-a .ed-hero {
    padding-block: clamp(2.6rem, 6vw, 5rem) 0;
}

.design-b .ed-hero {
    background: var(--surface);
    padding-block: clamp(2.1rem, 4.5vw, 3.5rem) clamp(1.5rem, 3vw, 2.3rem);
    border-bottom: 1px solid var(--line);
}

.ed-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.3rem;
    font-family: var(--font-display);
    font-size: 0.69rem;
    color: var(--muted);
}

.ed-crumbs a {
    color: var(--muted);
    text-decoration: none;
}

.ed-crumbs a:hover {
    color: var(--accent);
}

.ed-crumbs .sep {
    opacity: 0.45;
}

.ed-kicker {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
}

.design-a .ed-kicker {
    display: flex;
    align-items: center;
    gap: 0.8rem;
}

.design-a .ed-kicker::before {
    content: "";
    width: 2.4rem;
    height: 1px;
    background: currentColor;
}

.design-b .ed-kicker {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.78rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    letter-spacing: 0.07em;
}

.ed-title {
    margin-top: 1.05rem;
    color: var(--ink);
    text-wrap: balance;
}

.design-a .ed-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(2rem, 4.6vw, 3.5rem);
    line-height: 1.42;
    letter-spacing: -0.005em;
}

.design-b .ed-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.85rem, 3.9vw, 3rem);
    line-height: 1.46;
    max-width: 56rem;
}

.ed-lede {
    margin-top: 1.35rem;
    color: var(--muted);
}

.design-a .ed-lede {
    max-width: 48rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 2;
}

.design-b .ed-lede {
    max-width: 54rem;
    font-size: 0.98rem;
    line-height: 1.95;
}

.ed-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.15rem;
    margin-top: 1.9rem;
    font-family: var(--font-display);
    font-size: 0.73rem;
    color: var(--muted);
}

.design-a .ed-meta {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
}

.ed-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
}

.ed-meta-item i {
    color: var(--accent);
    font-size: 0.72rem;
}

.design-b .ed-meta {
    gap: 0.45rem;
}

.design-b .ed-meta-item {
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    background: var(--line-soft);
    color: var(--ink-soft);
}

.design-b .ed-meta-item i {
    color: var(--accent);
}

/* --------------------------------------------------------------------------
   Cover
   -------------------------------------------------------------------------- */
.ed-cover {
    margin-top: clamp(1.5rem, 3.5vw, 2.6rem);
}

.design-a .ed-cover .ed-container {
    max-width: 980px;
}

.design-b .ed-cover {
    margin-top: 0;
    padding-top: clamp(1.4rem, 3vw, 2.2rem);
    background: var(--paper);
}

.ed-cover-img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: center;
    border-radius: var(--radius);
    background: var(--line-soft);
}

.design-b .ed-cover-img {
    aspect-ratio: 21 / 9;
    border-radius: var(--radius);
}

/* --------------------------------------------------------------------------
   Main grid
   -------------------------------------------------------------------------- */
.ed-main {
    padding-block: clamp(2.2rem, 5vw, 4rem) 0;
}

.ed-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
}

@media (min-width: 1024px) {
    .design-b .ed-layout {
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 2.5rem;
    }
}

.ed-main-col {
    min-width: 0;
}

.design-a .ed-main-col {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
}

/* --------------------------------------------------------------------------
   Table of contents — inline (design A) and sidebar (design B)
   -------------------------------------------------------------------------- */
.ed-toc-inline {
    display: none;
}

.design-a .ed-toc-inline {
    display: block;
    margin-bottom: 2.9rem;
    padding-block: 1.2rem;
    border-block: 1px solid var(--line);
}

.ed-toc-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
}

.ed-toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 2;
    column-gap: 2.5rem;
}

@media (max-width: 640px) {
    .ed-toc-list {
        columns: 1;
    }
}

.ed-toc-list li {
    break-inside: avoid;
    margin-bottom: 0.35rem;
}

.ed-toc-list a {
    display: block;
    padding: 0.16rem 0;
    font-family: var(--font-display);
    font-size: 0.76rem;
    line-height: 1.7;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.18s ease;
}

.ed-toc-list a:hover {
    color: var(--accent);
}

.ed-toc-list .toc-3 {
    padding-inline-start: 1rem;
}

.ed-toc-list .toc-3 a {
    font-size: 0.71rem;
    color: var(--muted);
}

.ed-side {
    display: none;
}

@media (min-width: 1024px) {
    .design-b .ed-side {
        display: block;
        position: sticky;
        top: 1.5rem;
        align-self: start;
        max-height: calc(100vh - 3rem);
        overflow: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--line) transparent;
    }
}

.ed-side-card {
    padding: 1.15rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
}

.ed-side-card + .ed-side-card {
    margin-top: 0.9rem;
}

.ed-side-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
}

.ed-side-toc {
    margin: 0;
    padding: 0;
    list-style: none;
}

.ed-side-toc li + li {
    margin-top: 0.1rem;
}

.ed-side-toc a {
    display: block;
    padding: 0.32rem 0.55rem;
    border-inline-start: 2px solid transparent;
    border-radius: 6px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: 1.65;
    color: var(--ink-soft);
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
}

.ed-side-toc a:hover {
    border-inline-start-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-ink);
}

.ed-side-toc .toc-3 a {
    padding-inline-start: 1.2rem;
    font-size: 0.71rem;
    color: var(--muted);
}

.ed-side-meta {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: 0.72rem;
    color: var(--muted);
}

.ed-side-meta li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    padding-block: 0.42rem;
    border-bottom: 1px dashed var(--line-soft);
}

.ed-side-meta li:last-child {
    border-bottom: 0;
}

.ed-side-meta strong {
    color: var(--ink);
    font-weight: 600;
    text-align: end;
}

.ed-side-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.ed-side-author img {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    object-fit: cover;
    border: 2px solid var(--surface);
    box-shadow: 0 0 0 1px var(--line);
}

.ed-side-author-name {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink);
}

.ed-side-author-role {
    font-family: var(--font-display);
    font-size: 0.68rem;
    line-height: 1.7;
    color: var(--muted);
}

.ed-side-share {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
}

.ed-side-share a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.74rem;
    text-decoration: none;
    transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}

.ed-side-share a:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
}

/* --------------------------------------------------------------------------
   Article body
   -------------------------------------------------------------------------- */
.ed-body {
    counter-reset: ed-section;
    color: var(--ink-soft);
    font-family: var(--font-body);
    font-size: 1.14rem;
    line-height: 2.05;
    overflow-wrap: break-word;
}

html[dir="ltr"] .ed-body {
    font-size: 1.06rem;
    line-height: 1.85;
}

.design-b .ed-body {
    padding: clamp(1.4rem, 3.5vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
}

.ed-body p {
    margin-bottom: 1.5em;
}

.ed-body p:last-child {
    margin-bottom: 0;
}

.ed-body strong {
    color: var(--ink);
    font-weight: 700;
}

html[dir="rtl"] .ed-body em {
    font-style: normal;
}

.ed-body a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
}

.ed-body a:hover {
    text-decoration-color: currentColor;
}

/* Headings */
.ed-body h2 {
    position: relative;
    margin: 3.2rem 0 1.35rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-wrap: balance;
}

.ed-body > h2 {
    counter-increment: ed-section;
}

.ed-body > h2::before {
    content: counter(ed-section, decimal-leading-zero);
    display: block;
    margin-bottom: 0.55rem;
    font-family: var(--font-latin-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--accent);
}

.design-a .ed-body h2 {
    font-family: var(--font-body);
    font-size: clamp(1.6rem, 2.6vw, 2.05rem);
    font-weight: 700;
    line-height: 1.5;
}

.design-b .ed-body h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.72rem);
    font-weight: 800;
    line-height: 1.55;
}

.ed-body > h2:first-child {
    margin-top: 0;
}

.ed-body h3 {
    margin: 2.3rem 0 0.85rem;
    color: var(--ink);
}

.design-a .ed-body h3 {
    font-family: var(--font-body);
    font-size: clamp(1.18rem, 1.9vw, 1.46rem);
    font-weight: 700;
    line-height: 1.65;
}

.design-b .ed-body h3 {
    font-family: var(--font-display);
    font-size: clamp(1.06rem, 1.6vw, 1.24rem);
    font-weight: 700;
    line-height: 1.7;
}

.ed-body > h3::before,
.ed-body h3.is-standalone::before {
    content: "";
    display: inline-block;
    width: 0.46rem;
    height: 0.46rem;
    margin-inline-end: 0.55rem;
    background: var(--accent);
    vertical-align: 0.12em;
}

.ed-body h4 {
    margin: 1.7rem 0 0.55rem;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.7;
    color: var(--ink);
}

/* Paragraphs after headings get a little more air in the literary theme */
.design-a .ed-body h2 + p {
    font-size: 1.19rem;
    line-height: 2.1;
}

/* Drop cap for the English literary edition */
html[dir="ltr"] .design-a .ed-body > h2 + p::first-letter {
    float: inline-start;
    padding-inline-end: 0.55rem;
    padding-top: 0.3rem;
    font-family: var(--font-latin);
    font-size: 3.8rem;
    font-weight: 600;
    line-height: 0.82;
    color: var(--accent);
}

/* Lists */
.ed-body ul,
.ed-body ol {
    margin: 0 0 1.5rem;
    padding-inline-start: 1.35rem;
}

.ed-body li {
    margin-bottom: 0.4rem;
}

.ed-body li:last-child {
    margin-bottom: 0;
}

.ed-body ul li::marker {
    color: var(--accent);
}

.ed-body ol li::marker {
    color: var(--accent);
    font-family: var(--font-latin-display);
    font-weight: 700;
}

.design-a .ed-body ul {
    padding-inline-start: 0;
    list-style: none;
}

.design-a .ed-body ul > li {
    position: relative;
    padding-inline-start: 1.35rem;
}

.design-a .ed-body ul > li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0.9em;
    width: 0.65rem;
    height: 1px;
    background: var(--accent);
}

/* Quotes */
.essay-quote {
    margin: 2.4rem 0;
    padding: 1.9rem 0;
    border-block: 1px solid var(--line);
    text-align: center;
}

.design-b .essay-quote {
    padding: 1.4rem 1.6rem;
    border: 0;
    border-inline-start: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    background: var(--accent-soft);
    text-align: start;
}

.essay-quote::before {
    content: "\201C";
    display: block;
    margin-bottom: 0.4rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.45;
}

.design-b .essay-quote::before {
    display: none;
}

.essay-quote p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.95;
    color: var(--ink);
}

html[dir="ltr"] .essay-quote p {
    font-size: 1.16rem;
    line-height: 1.75;
}

/* Figures */
.essay-figure {
    margin: 2.4rem 0;
}

.essay-figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: var(--line-soft);
}

.essay-figure figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.71rem;
    line-height: 1.9;
    color: var(--muted);
    text-align: center;
}

/* --------------------------------------------------------------------------
   Notes, splits, cards, panels
   -------------------------------------------------------------------------- */
.essay-note {
    margin: 1.6rem 0;
    padding: 1.2rem 1.35rem;
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 0.98rem;
    line-height: 1.95;
}

.design-a .essay-note {
    padding: 0.2rem 1.35rem;
    border: 0;
    border-inline-start: 2px solid var(--accent);
    border-radius: 0;
    background: transparent;
}

.essay-note h3,
.essay-note h4 {
    margin-top: 0;
}

.essay-note h3::before {
    display: none;
}

.essay-note img {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 1rem;
    border-radius: calc(var(--radius) - 1px);
}

.essay-note--accent {
    background: var(--accent-soft);
}

.essay-split {
    display: grid;
    gap: 1.75rem;
    margin: 2rem 0;
}

@media (min-width: 760px) {
    .essay-split {
        grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
        align-items: start;
    }
}

.essay-split-side .essay-note {
    margin-top: 0;
}

.essay-cards {
    display: grid;
    gap: 1.15rem;
    margin: 2rem 0;
}

@media (min-width: 720px) {
    .essay-cards[data-cols="2"] {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .essay-cards[data-cols="3"] {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

.essay-cards > div {
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 2px);
    background: var(--surface);
}

.design-a .essay-cards > div {
    padding: 1rem 0 0;
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
}

.essay-cards h3,
.essay-cards h4 {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.65;
}

.essay-cards h3::before {
    display: none;
}

.essay-cards p {
    margin-bottom: 0.7rem;
    font-size: 0.94rem;
    line-height: 1.9;
}

.essay-cards ul {
    margin-bottom: 0;
    font-size: 0.94rem;
    line-height: 1.9;
}

.essay-panel {
    margin: 2.2rem 0;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 2px);
    background: var(--surface);
}

.design-a .essay-panel {
    padding: 0;
    border: 0;
    border-block: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
}

.essay-panel > h3:first-child {
    margin-top: 0;
}

/* --------------------------------------------------------------------------
   Historical chronicle
   -------------------------------------------------------------------------- */
.essay-timeline {
    margin: 1.8rem 0;
}

.essay-timeline-item {
    position: relative;
    padding-inline-start: 1.6rem;
    padding-bottom: 1.6rem;
    border-inline-start: 1px solid var(--line);
}

.essay-timeline-item:last-child {
    padding-bottom: 0;
}

.essay-timeline-item::before {
    content: "";
    position: absolute;
    inset-inline-start: -0.34rem;
    top: 0.5rem;
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--surface);
}

.design-a .essay-timeline-item::before {
    box-shadow: 0 0 0 4px var(--paper);
}

.essay-timeline-date {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
}

.essay-timeline-body h4 {
    margin: 0 0 0.35rem;
    font-size: 1rem;
}

.essay-timeline-body p {
    margin-bottom: 0;
    font-size: 0.96rem;
    line-height: 1.95;
}

/* --------------------------------------------------------------------------
   Five-era static chart (replaces the old JS animation)
   -------------------------------------------------------------------------- */
.essay-chart {
    margin: 2.4rem 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
}

.design-a .essay-chart {
    padding-inline: 0;
    border: 0;
    border-block: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
}

.essay-chart h3 {
    margin-top: 0;
}

.essay-chart-lede {
    margin-bottom: 1.8rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.9;
}

.essay-chart-track {
    position: relative;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

.essay-chart-epoch {
    position: relative;
    padding-top: 2.5rem;
}

.essay-chart-epoch::before {
    content: "";
    position: absolute;
    top: 1.1rem;
    left: 50%;
    width: 0.7rem;
    height: 0.7rem;
    margin-left: -0.35rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--surface);
}

.design-a .essay-chart-epoch::before {
    box-shadow: 0 0 0 5px var(--paper);
}

.essay-chart-era {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.69rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--accent-ink);
}

.essay-chart-points {
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.8;
}

.essay-chart-points li {
    padding-block: 0.35rem;
    border-top: 1px dotted var(--line);
}

.essay-chart-points li:first-child {
    border-top: 0;
}

@media (min-width: 760px) {
    .essay-chart-track {
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.7rem;
    }

    .essay-chart-track::before {
        content: "";
        position: absolute;
        top: 1.45rem;
        left: 0;
        right: 0;
        height: 1px;
        background: var(--line);
    }
}

@media (max-width: 759px) {
    .essay-chart-epoch {
        padding-top: 0;
        padding-inline-start: 1.5rem;
        padding-bottom: 1rem;
        border-inline-start: 1px solid var(--line);
    }

    .essay-chart-epoch:last-child {
        padding-bottom: 0;
    }

    .essay-chart-epoch::before {
        top: 0.55rem;
        left: auto;
        inset-inline-start: -0.36rem;
        margin-left: 0;
    }

    .essay-chart-era {
        position: static;
        display: block;
        margin-bottom: 0.35rem;
        text-align: start;
    }

    .essay-chart-points {
        text-align: start;
    }
}

.essay-chart-foot {
    margin-top: 1.6rem;
    margin-bottom: 0;
    font-size: 0.76rem;
    line-height: 1.85;
    color: var(--muted);
    text-align: center;
}

/* --------------------------------------------------------------------------
   Tables
   -------------------------------------------------------------------------- */
.essay-table-wrap {
    margin: 2.2rem 0;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
}

.design-a .essay-table-wrap {
    border: 0;
    border-radius: 0;
}

.ed-body table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.85;
}

.ed-body thead th {
    padding: 0.8rem 1rem;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    text-align: start;
}

.design-a .ed-body thead th {
    padding-inline: 0.6rem;
    background: transparent;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
}

.ed-body tbody td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line-soft);
    vertical-align: top;
}

.design-a .ed-body tbody td {
    padding-inline: 0.6rem;
}

.ed-body tbody tr:last-child td {
    border-bottom: 0;
}

.ed-body tbody td:first-child {
    font-weight: 700;
    color: var(--ink);
}

.design-b .ed-body tbody tr:nth-child(even) {
    background: #f8faf9;
}

/* --------------------------------------------------------------------------
   Sources, acknowledgements
   -------------------------------------------------------------------------- */
.essay-endnote {
    margin-top: 2.8rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--accent-soft);
}

.essay-endnote h3 {
    margin-top: 0;
}

.essay-credits {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: 0.75rem;
    line-height: 1.9;
    color: var(--muted);
}

.essay-sources {
    margin-top: 3rem;
    padding-top: 1.8rem;
    border-top: 2px solid var(--ink);
}

.essay-sources h2 {
    margin: 0 0 1.4rem;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 800;
    color: var(--ink);
}

.essay-sources h2::before {
    display: none;
}

.essay-sources-grid {
    display: grid;
    gap: 1.4rem;
}

@media (min-width: 700px) {
    .essay-sources-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

.essay-source-group h4 {
    margin: 0 0 0.65rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 0.78rem;
    color: var(--accent-ink);
}

.essay-source-group ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.76rem;
    line-height: 1.9;
}

.essay-source-group li {
    margin-bottom: 0.55rem;
}

.essay-source-group li::before {
    content: "•";
    margin-inline-end: 0.4rem;
    color: var(--accent);
}

/* --------------------------------------------------------------------------
   After the article: share + author
   -------------------------------------------------------------------------- */
.ed-after {
    margin-top: 2.2rem;
}

.ed-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
}

.ed-share-label {
    margin-inline-end: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.71rem;
    font-weight: 700;
    color: var(--muted);
}

.ed-share a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8rem;
    text-decoration: none;
    transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}

.ed-share a:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
}

.ed-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
}

.design-a .ed-author {
    padding: 1.5rem 0 0;
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
}

.ed-author img {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    object-fit: cover;
    border: 2px solid var(--surface);
    box-shadow: 0 0 0 1px var(--line);
}

.ed-author-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
}

.ed-author-role {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    line-height: 1.8;
    color: var(--muted);
}

.ed-author-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: 0.71rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
}

.ed-author-link:hover {
    text-decoration: underline;
}

/* --------------------------------------------------------------------------
   End-of-article CTA: services + contact
   -------------------------------------------------------------------------- */
.ed-cta {
    margin-top: 1.8rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
}

.design-a .ed-cta {
    border-radius: 0;
    background: var(--accent-soft);
    border-inline-start-color: var(--accent);
}

.ed-cta-eyebrow {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
}

.ed-cta-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink);
}

.ed-cta-text {
    margin: 0.45rem 0 0;
    font-family: var(--font-body);
    font-size: 0.86rem;
    line-height: 1.95;
    color: var(--muted);
}

.ed-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
}

.ed-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--surface);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
}

.ed-cta-btn:hover {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
    color: var(--surface);
}

.ed-cta-btn.ghost {
    background: transparent;
    color: var(--accent);
}

.ed-cta-btn.ghost:hover {
    background: var(--accent);
    color: var(--surface);
}

/* --------------------------------------------------------------------------
   Footer
   -------------------------------------------------------------------------- */
.ed-footer {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-block: 2rem;
    border-top: 1px solid var(--line);
    background: var(--surface);
}

.ed-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.71rem;
    color: var(--muted);
}

.ed-footer-inner a {
    color: var(--muted);
    text-decoration: none;
}

.ed-footer-inner a:hover {
    color: var(--accent);
}

/* --------------------------------------------------------------------------
   Small screens
   -------------------------------------------------------------------------- */
@media (max-width: 640px) {
    .design-a .ed-hero {
        padding-top: 1.8rem;
    }

    .design-a .ed-title {
        font-size: clamp(1.7rem, 7vw, 2.2rem);
        line-height: 1.5;
    }

    .design-b .ed-title {
        font-size: clamp(1.55rem, 6.5vw, 2rem);
        line-height: 1.55;
    }

    .ed-lede {
        font-size: 0.95rem;
        line-height: 1.95;
    }

    .ed-body {
        font-size: 1.08rem;
        line-height: 2;
    }

    html[dir="ltr"] .ed-body {
        font-size: 1.01rem;
        line-height: 1.8;
    }

    .design-a .ed-body h2 {
        font-size: 1.45rem;
    }

    .essay-quote {
        padding-block: 1.4rem;
    }

    .essay-quote p {
        font-size: 1.12rem;
    }

    .ed-author {
        align-items: flex-start;
    }

    .ed-body table {
        font-size: 0.82rem;
    }
}

/* --------------------------------------------------------------------------
   Study note, chips, question list, tag list
   -------------------------------------------------------------------------- */
.essay-about {
    margin: 0 0 2.4rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 0.92rem;
    line-height: 1.95;
    color: var(--ink-soft);
}

.design-a .essay-about {
    padding: 0.9rem 1.1rem;
    border: 0;
    border-inline-start: 2px solid var(--accent);
    border-radius: 0;
    background: var(--accent-soft);
}

.essay-about-label {
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
}

.essay-about p:last-child {
    margin-bottom: 0;
}

.essay-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
}

.design-a .essay-chips {
    padding: 0;
}

.essay-chips li {
    padding: 0.22rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-display);
    font-size: 0.71rem;
    line-height: 1.8;
    color: var(--accent-ink);
}

.design-a .essay-chips li {
    background: transparent;
}

.essay-points {
    margin: 0;
    padding: 0 !important;
    list-style: none;
}

.design-a .essay-points > li {
    padding-inline-start: 0;
}

.design-a .essay-points > li::before {
    display: none;
}

.essay-points > li {
    margin-bottom: 0;
    padding-block: 0.75rem;
    border-top: 1px solid var(--line-soft);
}

.essay-points > li:first-child {
    border-top: 0;
    padding-top: 0.25rem;
}

.essay-points h4 {
    margin: 0 0 0.2rem;
}

.essay-points p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.85;
    color: var(--muted);
}

.essay-panel--questions {
    margin: 1.8rem 0;
}

.essay-panel--questions ol {
    margin: 0;
    padding-inline-start: 1.4rem;
    font-size: 1.05rem;
    line-height: 1.95;
}

.essay-panel--questions li {
    margin-bottom: 0.7rem;
}

.essay-panel--questions li:last-child {
    margin-bottom: 0;
}

.essay-note--media {
    padding-top: 0;
}

.essay-note--media img {
    margin-top: 0;
}

.ed-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
}

.ed-tags li {
    padding: 0.24rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.68rem;
    color: var(--muted);
}

.ed-tags a {
    color: inherit;
    text-decoration: none;
}

.ed-tags a:hover {
    color: var(--accent);
}

.ed-comments {
    margin-top: 2.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
}

.ed-comments-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.2rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
}

.ed-comments .fb-comments {
    margin-bottom: 2rem;
}

.ed-side-author + .ed-side-share {
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-soft);
}

.ed-body h5 {
    margin: 1.35rem 0 0.45rem;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.7;
    color: var(--ink);
}

.ed-body h5 + ul {
    font-size: 0.9rem;
    line-height: 1.85;
}

.essay-chart h4 {
    margin-top: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    font-weight: 700;
    color: var(--ink);
}

/* Stacked table on narrow screens: each cell keeps its column label. */
@media (max-width: 700px) {
    .essay-table-wrap {
        overflow: visible;
        border: 0;
        border-radius: 0;
    }

    .ed-body table {
        min-width: 0;
        font-size: 0.92rem;
    }

    .ed-body thead {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }

    .ed-body tbody tr {
        display: block;
        padding: 0.5rem 0 0.9rem;
        border-bottom: 1px solid var(--line);
    }

    .ed-body tbody tr:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .design-a .ed-body tbody tr {
        border-bottom: 1px solid var(--line);
    }

    .ed-body tbody td {
        display: block;
        padding: 0.2rem 0;
        border: 0;
    }

    .design-a .ed-body tbody td {
        padding-inline: 0;
    }

    .ed-body tbody td:first-child {
        padding-bottom: 0.35rem;
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        color: var(--accent-ink);
    }

    .ed-body tbody td[data-label]:not(:first-child)::before {
        content: attr(data-label);
        display: block;
        margin-bottom: 0.1rem;
        font-family: var(--font-display);
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
    }
}

/* --------------------------------------------------------------------------
   Print
   -------------------------------------------------------------------------- */
@media print {
    .ed-sitebar,
    .ed-side,
    .ed-share,
    .ed-toc-inline,
    .ed-footer,
    .ed-cover figcaption {
        display: none !important;
    }

    .ed-root,
    .ed-body,
    .design-b .ed-body {
        background: #fff !important;
        border: 0 !important;
        padding: 0 !important;
    }

    .ed-main,
    .ed-hero {
        padding-block: 0 !important;
    }

    .ed-body {
        font-size: 11.5pt;
        line-height: 1.7;
    }
}

/* ==========================================================================
   TOPIC THEMES
   Each research category gets its own paper tint, accent and hero motif.
   The theme is set on the article root by `_layouts/post.liquid`
   (from `page.category`, or overridden with `theme:` in the front matter).
   ========================================================================== */
.design-a[data-theme="water"] {
    --paper: #f1f0e6;
    --surface: #faf9f1;
    --line: #d8d6c4;
    --line-soft: #e7e5d6;
    --accent: #2e6f68;
    --accent-soft: #dcebe6;
    --accent-ink: #1f534e;
}

.design-a[data-theme="craft"] {
    --paper: #f6f1e6;
    --surface: #fbf8f1;
    --line: #dcd1bd;
    --line-soft: #e9e1d1;
    --accent: #8a5a2b;
    --accent-soft: #efe4d0;
    --accent-ink: #6f4520;
}

.design-a[data-theme="geography"] {
    --paper: #f4f0e0;
    --surface: #fbf8ec;
    --line: #ddd5b9;
    --line-soft: #eae3cd;
    --accent: #6d6a2f;
    --accent-soft: #e9e6cb;
    --accent-ink: #55521f;
}

.design-a[data-theme="religion"] {
    --paper: #f3eee6;
    --surface: #faf6f0;
    --line: #dcd0c8;
    --line-soft: #e9e0d9;
    --accent: #6b4a7a;
    --accent-soft: #ebe1ef;
    --accent-ink: #543a61;
}

.design-a[data-theme="environment"] {
    --paper: #f1f1e4;
    --surface: #f9f9ef;
    --line: #d6d8c2;
    --line-soft: #e5e7d6;
    --accent: #4a6b34;
    --accent-soft: #e2ead7;
    --accent-ink: #3a5528;
}

.design-a[data-theme="heritage"] {
    --paper: #f5efe5;
    --surface: #fbf7f0;
    --line: #dccfc0;
    --line-soft: #eae1d6;
    --accent: #9a5b3a;
    --accent-soft: #f1e1d6;
    --accent-ink: #7a4530;
}

.design-a[data-theme="thought"] {
    --paper: #f2f1e9;
    --surface: #faf9f4;
    --line: #d7d6c9;
    --line-soft: #e6e5da;
    --accent: #4a5568;
    --accent-soft: #e3e7ee;
    --accent-ink: #39424f;
}

.design-a[data-theme="economy"] {
    --paper: #f4f0e2;
    --surface: #fbf8ee;
    --line: #dcd4bb;
    --line-soft: #eae3d0;
    --accent: #8a6a1f;
    --accent-soft: #efe7cd;
    --accent-ink: #6b5318;
}

/* --------------------------------------------------------------------------
   Hero motif — a quiet engraved field behind the title
   -------------------------------------------------------------------------- */
.design-a .ed-hero {
    position: relative;
    overflow: hidden;
}

.design-a .ed-hero::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: 0;
    width: min(44%, 540px);
    pointer-events: none;
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(to right, #000, transparent 94%);
    mask-image: linear-gradient(to right, #000, transparent 94%);
}

.design-a .ed-hero > .ed-container {
    position: relative;
    z-index: 1;
}

.design-a[data-theme="water"] .ed-hero::before {
    background-image:
        repeating-radial-gradient(circle at 10% 84%, transparent 0 26px, color-mix(in srgb, var(--accent) 34%, transparent) 26px 27px),
        repeating-radial-gradient(circle at 44% 14%, transparent 0 36px, color-mix(in srgb, var(--accent) 24%, transparent) 36px 37px);
}

.design-a[data-theme="craft"] .ed-hero::before {
    background-image:
        repeating-linear-gradient(45deg, color-mix(in srgb, var(--accent) 30%, transparent) 0 1px, transparent 1px 14px),
        repeating-linear-gradient(-45deg, color-mix(in srgb, var(--accent) 22%, transparent) 0 1px, transparent 1px 14px);
}

.design-a[data-theme="geography"] .ed-hero::before {
    background-image:
        linear-gradient(to right, color-mix(in srgb, var(--accent) 30%, transparent) 1px, transparent 1px),
        linear-gradient(to bottom, color-mix(in srgb, var(--accent) 30%, transparent) 1px, transparent 1px);
    background-size: 52px 52px;
}

.design-a[data-theme="religion"] .ed-hero::before {
    background-image: repeating-conic-gradient(from 22.5deg at 50% 50%, color-mix(in srgb, var(--accent) 26%, transparent) 0 12deg, transparent 12deg 45deg);
    background-size: 66px 66px;
}

.design-a[data-theme="environment"] .ed-hero::before {
    background-image: repeating-radial-gradient(circle at 6% 98%, transparent 0 18px, color-mix(in srgb, var(--accent) 30%, transparent) 18px 19px);
}

.design-a[data-theme="heritage"] .ed-hero::before {
    background-image: repeating-radial-gradient(circle at 50% 122%, transparent 0 58px, color-mix(in srgb, var(--accent) 30%, transparent) 58px 59px);
}

.design-a[data-theme="thought"] .ed-hero::before {
    background-image: radial-gradient(color-mix(in srgb, var(--accent) 38%, transparent) 1.1px, transparent 1.1px);
    background-size: 22px 22px;
}

.design-a[data-theme="economy"] .ed-hero::before {
    background-image: repeating-linear-gradient(to right, color-mix(in srgb, var(--accent) 32%, transparent) 0 1px, transparent 1px 30px);
}

@media (max-width: 760px) {
    .design-a .ed-hero::before {
        width: 100%;
        opacity: 0.22;
    }
}

/* --------------------------------------------------------------------------
   Legacy essay markup
   The published essays were written with Tailwind's amber/stone utilities.
   Inside the paper article they are re-mapped onto the active topic theme
   so every category reads as one coherent document.
   -------------------------------------------------------------------------- */
.design-a[data-theme] .ed-body [class*="text-amber-1"],
.design-a[data-theme] .ed-body [class*="text-amber-2"],
.design-a[data-theme] .ed-body [class*="text-amber-3"] {
    color: #f7f1e2;
}

.design-a[data-theme] .ed-body [class*="text-amber-4"],
.design-a[data-theme] .ed-body [class*="text-amber-5"],
.design-a[data-theme] .ed-body [class*="text-amber-6"],
.design-a[data-theme] .ed-body [class*="text-amber-7"] {
    color: var(--accent);
}

.design-a[data-theme] .ed-body [class*="text-amber-8"],
.design-a[data-theme] .ed-body [class*="text-amber-9"] {
    color: var(--accent-ink);
}

.design-a[data-theme] .ed-body [class*="text-stone-8"],
.design-a[data-theme] .ed-body [class*="text-stone-9"] {
    color: var(--ink);
}

.design-a[data-theme] .ed-body [class*="text-stone-6"],
.design-a[data-theme] .ed-body [class*="text-stone-7"] {
    color: var(--ink-soft);
}

.design-a[data-theme] .ed-body [class*="text-stone-4"],
.design-a[data-theme] .ed-body [class*="text-stone-5"] {
    color: var(--muted);
}

.design-a[data-theme] .ed-body [class~="bg-amber-500"],
.design-a[data-theme] .ed-body [class~="bg-amber-600"],
.design-a[data-theme] .ed-body [class~="bg-amber-700"],
.design-a[data-theme] .ed-body [class~="bg-amber-800"],
.design-a[data-theme] .ed-body [class~="bg-amber-900"] {
    background-color: var(--accent);
}

.design-a[data-theme] .ed-body [class~="bg-amber-50"],
.design-a[data-theme] .ed-body [class~="bg-amber-50/50"],
.design-a[data-theme] .ed-body [class~="bg-amber-100"],
.design-a[data-theme] .ed-body [class~="bg-amber-100/30"],
.design-a[data-theme] .ed-body [class~="bg-amber-200"],
.design-a[data-theme] .ed-body [class~="bg-amber-200/20"],
.design-a[data-theme] .ed-body [class~="bg-amber-200/40"],
.design-a[data-theme] .ed-body [class~="bg-amber-300/40"] {
    background-color: color-mix(in srgb, var(--accent) 11%, transparent);
}

.design-a[data-theme] .ed-body [class~="bg-stone-50"],
.design-a[data-theme] .ed-body [class~="bg-stone-100"],
.design-a[data-theme] .ed-body [class~="bg-stone-200"] {
    background-color: var(--surface);
}

.design-a[data-theme] .ed-body [class~="bg-white"],
.design-a[data-theme] .ed-body [class~="bg-white/80"] {
    background-color: var(--surface);
}

.design-a[data-theme] .ed-body [class~="border-amber-500"],
.design-a[data-theme] .ed-body [class~="border-amber-500/50"],
.design-a[data-theme] .ed-body [class~="border-amber-600"] {
    border-color: var(--accent);
}

.design-a[data-theme] .ed-body [class~="border-amber-100"],
.design-a[data-theme] .ed-body [class~="border-amber-200"],
.design-a[data-theme] .ed-body [class~="border-amber-200/50"],
.design-a[data-theme] .ed-body [class~="border-amber-200/60"],
.design-a[data-theme] .ed-body [class~="border-amber-400"] {
    border-color: var(--line);
}

.design-a[data-theme] .ed-body [class~="border-stone-100"],
.design-a[data-theme] .ed-body [class~="border-stone-200"],
.design-a[data-theme] .ed-body [class~="border-stone-200/60"] {
    border-color: var(--line);
}

.design-a[data-theme] .ed-body [class*="from-amber-1"],
.design-a[data-theme] .ed-body [class*="from-amber-2"],
.design-a[data-theme] .ed-body [class*="from-amber-3"] {
    --tw-gradient-from: color-mix(in srgb, var(--accent) 14%, transparent);
}

.design-a[data-theme] .ed-body [class*="to-amber-1"],
.design-a[data-theme] .ed-body [class*="to-amber-2"],
.design-a[data-theme] .ed-body [class*="to-amber-3"] {
    --tw-gradient-to: color-mix(in srgb, var(--accent) 6%, transparent);
}

.design-a[data-theme] .ed-body [class*="via-amber-"] {
    --tw-gradient-via: color-mix(in srgb, var(--accent) 10%, transparent);
}

.design-a[data-theme] .ed-body [class*="from-stone-"] {
    --tw-gradient-from: var(--surface);
}

.design-a[data-theme] .ed-body [class*="to-stone-"] {
    --tw-gradient-to: var(--paper);
}

.design-a[data-theme] .ed-body [class*="shadow-sm"],
.design-a[data-theme] .ed-body [class*="shadow-md"],
.design-a[data-theme] .ed-body [class*="shadow-lg"],
.design-a[data-theme] .ed-body [class*="shadow-xl"],
.design-a[data-theme] .ed-body [class*="shadow-2xl"] {
    box-shadow: 0 20px 44px -38px rgba(36, 31, 25, 0.7);
}

/* Callout titles keep their own scale instead of the section scale. */
.design-a[data-theme] .ed-body .not-prose h2 {
    margin: 0 0 0.75rem;
    padding-top: 0;
    border-top: 0;
    font-size: 1.18rem;
    line-height: 1.6;
}

.design-a[data-theme] .ed-body .not-prose h2::before {
    display: none;
}

/* --------------------------------------------------------------------------
   Site chrome around a reading page
   -------------------------------------------------------------------------- */
body.post-edition {
    background: #f3f0e7;
}

body.post-edition #preloader {
    background: #f3f0e7;
}

body.post-edition header > div.absolute {
    background: #f3f0e7 !important;
    box-shadow: none !important;
    border-bottom: 1px solid #cfc6b0;
}

body.post-edition header .bg-white {
    background: #f3f0e7 !important;
}

body.post-edition header .text-stone-900,
body.post-edition header .text-stone-800 {
    color: #131f1b !important;
}

body.post-edition header .text-stone-700 {
    color: #3b463f !important;
}

body.post-edition header .text-amber-600 {
    color: #8f6524 !important;
}

body.post-edition header .hover\:text-amber-700:hover {
    color: #2e6f68 !important;
}

body.post-edition header .bg-amber-600 {
    background: #8f6524 !important;
}

body.post-edition header .bg-amber-100 {
    background: #e4ede9 !important;
}

body.post-edition footer.bg-stone-900 {
    background: #0b1c17 !important;
    border-top: 1px solid rgba(201, 163, 95, 0.28);
}

body.post-edition footer .text-amber-400,
body.post-edition footer .text-amber-500,
body.post-edition footer .text-amber-600 {
    color: #c9a35f !important;
}

body.post-edition footer .text-stone-300 {
    color: #c9bea6 !important;
}

body.post-edition footer .text-stone-400 {
    color: #a8a08d !important;
}

body.post-edition footer .text-stone-500 {
    color: #918a79 !important;
}

body.post-edition footer .border-stone-700 {
    border-color: rgba(201, 163, 95, 0.22) !important;
}

body.post-edition #back-to-top {
    background: #2e6f68 !important;
}

@media (prefers-reduced-motion: reduce) {
    .design-a .ed-hero::before {
        opacity: 0.35;
    }
}
