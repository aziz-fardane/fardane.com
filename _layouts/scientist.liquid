---
layout: default
---

{% assign cat_label = 'علوم المياه' %}
{% case page.category %}
    {% when 'engineering' %}{% assign cat_label = 'الهندسة المائية' %}
    {% when 'geography' %}{% assign cat_label = 'الجغرافيا المائية' %}
    {% when 'medicine' %}{% assign cat_label = 'الطب المائي' %}
    {% when 'agriculture' %}{% assign cat_label = 'الزراعة المائية' %}
    {% when 'astronomy' %}{% assign cat_label = 'الفلك والمواقيت المائية' %}
    {% when 'chemistry' %}{% assign cat_label = 'الكيمياء المائية' %}
    {% when 'jurisprudence' %}{% assign cat_label = 'الفقه المائي' %}
{% endcase %}

{% assign region_label = 'المشرق' %}
{% case page.region %}
    {% when 'maghreb' %}{% assign region_label = 'المغرب' %}
    {% when 'andalus' %}{% assign region_label = 'الأندلس' %}
    {% when 'mashriq' %}{% assign region_label = 'المشرق' %}
{% endcase %}

{% assign _sci_key = page.image | remove_first: '/' %}
{% assign _sci_url = site.data.manifest[_sci_key] | default: page.image | default: '/dist/images/scientists/default.jpg' %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "الرئيسية",
      "item": "{{ site.url }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "العلماء",
      "item": "{{ site.url }}/scientists"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ page.name | escape }}",
      "item": "{{ page.url | absolute_url }}"
    }
  ]
}
</script>

<style>
    .sci{
        --paper:#f3f0e7;
        --paper-2:#faf8f2;
        --ink:#131f1b;
        --graphite:#3b463f;
        --muted:#6f6a5c;
        --line:#d9d2c1;
        --line-strong:#c3baa5;
        --brass:#a67a2e;
        --brass-text:#8f6524;
        --brass-2:#c9a35f;
        --water:#2e6f68;
        --water-2:#4f938b;
        --water-soft:#e4ede9;
        --night:#0b1c17;
        --night-2:#081411;
        --mono:"IBM Plex Mono",ui-monospace,SFMono-Regular,Consolas,monospace;
        --kufi:"Noto Kufi Arabic",system-ui,sans-serif;
        --naskh:"Noto Naskh Arabic",Georgia,serif;
        background:var(--paper);
        color:var(--graphite);
        font-family:var(--naskh);
    }
    .sci h1,.sci h2,.sci h3,.sci h4{font-family:var(--kufi);color:var(--ink);line-height:1.45;margin:0}
    .sci-wrap{max-width:1180px;margin:0 auto;padding:0 1.5rem}
    .sci .code{font-family:var(--mono);font-size:10px;font-weight:500;letter-spacing:.14em;color:var(--muted);text-transform:uppercase;margin:0}
    .sci .code b{color:var(--brass-text);font-weight:500}

    /* ================= HERO ================= */
    .sci-hero{position:relative;overflow:hidden;background:linear-gradient(155deg,#0e241e 0%,#0b1c17 55%,#081411 100%);color:#e7dfcc}
    .sci-hero-grid{
        position:absolute;inset:0;pointer-events:none;opacity:.5;
        background-image:
            linear-gradient(to left,rgba(201,163,95,.10) 1px,transparent 1px),
            linear-gradient(to bottom,rgba(201,163,95,.10) 1px,transparent 1px);
        background-size:34px 34px;
        mask-image:radial-gradient(circle at 78% 22%,#000 16%,transparent 76%);
        -webkit-mask-image:radial-gradient(circle at 78% 22%,#000 16%,transparent 76%);
    }
    .sci-hero-fig{
        position:absolute;left:-70px;bottom:-40px;width:min(46vw,520px);height:auto;
        opacity:.3;z-index:1;pointer-events:none;
    }
    .sci-hero-fig line,.sci-hero-fig circle,.sci-hero-fig path{vector-effect:non-scaling-stroke}
    .sci-hero-fig .wheel{transform-box:fill-box;transform-origin:center;animation:sciWheel 150s linear infinite}
    @keyframes sciWheel{to{transform:rotate(-360deg)}}
    .sci-hero-inner{position:relative;z-index:2;padding:2.6rem 1.5rem 0}
    .sci-platebar{
        display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;
        border-bottom:1px solid rgba(201,163,95,.28);padding-bottom:.75rem;margin-bottom:2.4rem;
        font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:#9d9075;
    }
    .sci-platebar .lat{color:var(--brass-2)}
    .sci-hero-main{
        display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,320px);
        gap:2.6rem;align-items:end;padding-bottom:2.8rem;
    }
    .sci-kicker{
        display:inline-flex;align-items:center;gap:.55rem;
        font-family:var(--kufi);font-size:11px;font-weight:700;letter-spacing:.16em;
        color:var(--brass-2);margin:0 0 1rem;
    }
    .sci-kicker::before{content:"";width:22px;height:1px;background:var(--brass-2);opacity:.8}
    .sci-hero h1{
        font-size:clamp(2.1rem,4.6vw,3.6rem);font-weight:800;color:#f5efdf;line-height:1.26;
        letter-spacing:-.01em;max-width:22ch;
    }
    .sci-hero h1 span{color:var(--brass-2)}
    .sci-meta{
        display:flex;flex-wrap:wrap;gap:.55rem 1.6rem;margin:1.5rem 0 0;
        border-top:1px solid rgba(201,163,95,.22);border-bottom:1px solid rgba(201,163,95,.22);
        padding:.8rem 0;
    }
    .sci-meta div{display:flex;align-items:baseline;gap:.55rem;min-width:0}
    .sci-meta dt{
        font-family:var(--mono);font-size:9px;letter-spacing:.12em;color:#8e8268;
        text-transform:uppercase;white-space:nowrap;
    }
    .sci-meta dd{margin:0;font-family:var(--kufi);font-size:.82rem;font-weight:600;color:#e6dcc6;line-height:1.7}
    .sci-tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1.1rem;list-style:none;padding:0}
    .sci-tags li{
        font-family:var(--kufi);font-size:.68rem;font-weight:600;color:#cdbf9f;
        border:1px solid rgba(201,163,95,.35);padding:.28rem .62rem;line-height:1.6;
    }
    .sci-portrait{position:relative;margin:0}
    .sci-portrait-frame{
        position:relative;border:1px solid rgba(201,163,95,.45);padding:7px;background:rgba(8,20,17,.55);
    }
    .sci-portrait-frame::before,.sci-portrait-frame::after{
        content:"";position:absolute;width:13px;height:13px;border:1px solid var(--brass-2);
    }
    .sci-portrait-frame::before{top:-1px;right:-1px;border-left:0;border-bottom:0}
    .sci-portrait-frame::after{bottom:-1px;left:-1px;border-right:0;border-top:0}
    .sci-portrait img{
        display:block;width:100%;height:300px;object-fit:cover;object-position:center 22%;
        filter:grayscale(.28) sepia(.14) contrast(1.02);
    }
    .sci-portrait figcaption{
        display:flex;justify-content:space-between;gap:.5rem;margin-top:.45rem;
        font-family:var(--mono);font-size:8.5px;letter-spacing:.1em;color:#9d9075;
    }
    .sci-portrait figcaption b{font-weight:500;color:var(--brass-2)}
    .sci-ruler{
        position:relative;z-index:2;height:34px;border-top:1px solid rgba(201,163,95,.25);
        background-image:
            repeating-linear-gradient(to left,rgba(201,163,95,.5) 0 1px,transparent 1px 34px),
            repeating-linear-gradient(to left,rgba(201,163,95,.9) 0 1px,transparent 1px 170px);
        background-size:auto 9px,auto 16px;
        background-repeat:repeat-x;
    }

    /* ================= BODY ================= */
    .sci-body{padding:2.2rem 0 4rem;background:var(--paper)}
    .sci-crumb{
        display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;
        border-bottom:1px solid var(--line-strong);padding-bottom:.7rem;margin-bottom:2.2rem;
        font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;color:var(--muted);
    }
    .sci-crumb a{color:var(--brass-text);text-decoration:none;border-bottom:1px solid transparent;transition:.2s}
    .sci-crumb a:hover{color:var(--water);border-bottom-color:var(--water)}
    .sci-layout{display:grid;grid-template-columns:minmax(0,1fr) 318px;gap:2.6rem;align-items:start}
    .sci-article{
        position:relative;background:var(--paper-2);border:1px solid var(--line-strong);
        padding:clamp(1.4rem,3vw,2.6rem) clamp(1.2rem,3vw,2.8rem);
    }
    .sci-article::before{content:"";position:absolute;top:-1px;right:-1px;width:14px;height:14px;border-top:2px solid var(--brass);border-right:2px solid var(--brass)}
    .sci-article-head{
        display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;
        border-bottom:1px solid var(--line-strong);padding-bottom:.75rem;margin-bottom:1.6rem;
    }
    .sci-article-head .ar{font-family:var(--kufi);font-size:.78rem;font-weight:700;color:var(--ink)}
    .sci-article-head .en{font-family:var(--mono);font-size:9px;letter-spacing:.12em;color:var(--muted);direction:ltr}

    /* ================= PROSE ================= */
    .sci-prose{counter-reset:sciSec;font-size:1.01rem;line-height:2.05;color:var(--graphite)}
    .sci-lede{
        margin:0;padding:.2rem 1rem .2rem 0;border-right:2px solid var(--brass-2);
        font-size:1.06rem;line-height:2.1;color:var(--graphite);
    }
    .sci-prose h2{
        counter-increment:sciSec;position:relative;
        font-size:clamp(1.24rem,2vw,1.5rem);font-weight:800;color:var(--ink);
        margin:2.6rem 0 1rem;padding:0 0 .55rem;border-bottom:1px solid var(--line-strong);
    }
    .sci-prose h2:first-child{margin-top:0}
    .sci-prose h2::before{
        content:"§ " counter(sciSec,decimal-leading-zero);
        font-family:var(--mono);font-size:10px;font-weight:500;letter-spacing:.12em;
        color:var(--brass-text);margin-left:.65rem;vertical-align:.22em;
    }
    .sci-prose h3{
        position:relative;font-size:1.06rem;font-weight:700;color:var(--water);
        margin:1.8rem 0 .55rem;padding-right:.7rem;
    }
    .sci-prose h3::before{content:"";position:absolute;right:0;top:.3em;bottom:.3em;width:2px;background:var(--brass-2)}
    .sci-prose p{margin:0 0 1.05rem;text-align:justify;text-justify:inter-word}
    .sci-prose > p:first-of-type{font-size:1.07rem;color:#2c3833}
    .sci-prose strong{color:var(--ink);font-weight:700}
    .sci-prose em{color:var(--water)}
    .sci-prose a{color:var(--water);text-decoration:none;border-bottom:1px solid rgba(46,111,104,.4);transition:.2s}
    .sci-prose a:hover{color:var(--brass-text);border-bottom-color:var(--brass)}
    .sci-prose ul,.sci-prose ol{margin:.3rem 0 1.3rem;padding:0;list-style:none}
    .sci-prose li{position:relative;padding-right:1.05rem;margin-bottom:.5rem;line-height:1.95}
    .sci-prose ul > li::before{
        content:"";position:absolute;right:0;top:.82em;width:9px;height:1px;background:var(--brass);
    }
    .sci-prose ol{counter-reset:sciItem}
    .sci-prose ol > li{counter-increment:sciItem}
    .sci-prose ol > li::before{
        content:counter(sciItem) ".";
        position:absolute;right:0;top:0;font-family:var(--mono);font-size:9px;color:var(--brass-text);
    }
    .sci-prose blockquote{
        margin:1.4rem 0;padding:.9rem 1.1rem;background:var(--water-soft);
        border-right:3px solid var(--water);color:#2c3833;
    }
    .sci-prose blockquote p:last-child{margin-bottom:0}
    .sci-prose hr{border:0;border-top:1px solid var(--line-strong);margin:2rem 0}
    .sci-prose code{font-family:var(--mono);font-size:.86em;background:#ece6d7;padding:.1em .35em;color:var(--ink)}
    .sci-prose table{width:100%;border-collapse:collapse;margin:1.2rem 0;font-size:.86rem}
    .sci-prose th,.sci-prose td{border:1px solid var(--line);padding:.45rem .65rem;text-align:right}
    .sci-prose th{background:#eee9dc;font-family:var(--kufi);color:var(--ink)}

    .sci-foot{
        display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;
        margin-top:2.4rem;padding-top:1.1rem;border-top:1px solid var(--line-strong);
    }
    .sci-back{
        display:inline-flex;align-items:center;gap:.55rem;padding:.7rem 1.15rem;
        border:1px solid var(--line-strong);color:var(--brass-text);
        font-family:var(--kufi);font-size:.78rem;font-weight:700;text-decoration:none;transition:.2s;
    }
    .sci-back:hover{border-color:var(--brass);background:rgba(166,122,46,.06);color:var(--water)}
    .sci-back i{font-size:.72rem}
    .sci-end{font-family:var(--mono);font-size:9px;letter-spacing:.14em;color:var(--muted);direction:ltr}

    /* ================= ASIDE ================= */
    .sci-aside{display:flex;flex-direction:column;gap:1.1rem;position:sticky;top:1.4rem}
    .sci-card{position:relative;background:var(--paper-2);border:1px solid var(--line-strong);padding:1.1rem 1.15rem}
    .sci-card::before{content:"";position:absolute;top:-1px;right:-1px;width:11px;height:11px;border-top:1px solid var(--brass);border-right:1px solid var(--brass);opacity:.8}
    .sci-card h2{font-size:.98rem;font-weight:800;margin:.2rem 0 .8rem;padding-bottom:.55rem;border-bottom:1px solid var(--line)}
    .sci-dl{margin:0;display:flex;flex-direction:column}
    .sci-dl div{display:grid;grid-template-columns:84px minmax(0,1fr);gap:.6rem;padding:.5rem 0;border-top:1px solid var(--line)}
    .sci-dl div:first-child{border-top:0;padding-top:.1rem}
    .sci-dl dt{font-family:var(--mono);font-size:8.5px;letter-spacing:.08em;color:var(--brass-text);text-transform:uppercase;padding-top:.2rem}
    .sci-dl dd{margin:0;font-family:var(--kufi);font-size:.78rem;font-weight:600;color:var(--ink);line-height:1.8}
    .sci-card-tags{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.75rem}
    .sci-card-tags span{font-size:.66rem;color:var(--muted);border:1px solid var(--line);padding:.18rem .45rem;line-height:1.6}
    .sci-rel{display:flex;flex-direction:column;gap:.65rem}
    .sci-rel a{display:grid;grid-template-columns:42px minmax(0,1fr);gap:.65rem;align-items:center;text-decoration:none;color:inherit;padding:.35rem;border:1px solid transparent;transition:.18s}
    .sci-rel a:hover{border-color:var(--line);background:var(--water-soft)}
    .sci-rel-thumb{width:42px;height:42px;overflow:hidden;border:1px solid var(--line-strong);background:#e9e3d4;filter:grayscale(.3) sepia(.1)}
    .sci-rel-thumb img{width:100%;height:100%;object-fit:cover;display:block}
    .sci-rel b{display:block;font-family:var(--kufi);font-size:.78rem;font-weight:700;color:var(--ink);line-height:1.6}
    .sci-rel a:hover b{color:var(--water)}
    .sci-rel span{display:block;font-size:.7rem;color:var(--muted);line-height:1.7;margin-top:.1rem}
    .sci-card-archive{background:linear-gradient(150deg,#0e241e,#0b1c17 70%,#081411);border-color:rgba(201,163,95,.4);color:#c9bea6}
    .sci-card-archive .code{color:#a99d85}
    .sci-card-archive .code b{color:var(--brass-2)}
    .sci-card-archive h2{color:#f2ead8;border-bottom-color:rgba(201,163,95,.25)}
    .sci-card-archive p{font-size:.78rem;line-height:1.9;color:#bdb29b;margin:.2rem 0 .85rem}
    .sci-card-archive a{
        display:inline-flex;align-items:center;gap:.45rem;font-family:var(--kufi);font-size:.76rem;font-weight:700;
        color:var(--brass-2);text-decoration:none;border-bottom:1px solid rgba(201,163,95,.45);padding-bottom:.15rem;
    }
    .sci-card-archive a:hover{color:#f2ead8;border-bottom-color:#f2ead8}
    .sci-card-archive .stamp{
        display:block;margin-top:.9rem;font-family:var(--mono);font-size:8px;letter-spacing:.12em;color:#8e8268;
    }

    /* ================= SHARED SHELL ON SCIENTIST PAGES ================= */
    body.sci-page{background:#f3f0e7}
    body.sci-page #preloader{background:#f3f0e7}
    body.sci-page #preloader .border-amber-600{border-color:#a67a2e}
    body.sci-page header > div.absolute{background:#f3f0e7!important;box-shadow:none!important;border-bottom:1px solid #d9d2c1}
    body.sci-page header .bg-white{background:#f3f0e7!important}
    body.sci-page header .text-stone-900{color:#131f1b!important}
    body.sci-page header .text-stone-800{color:#131f1b!important}
    body.sci-page header .text-stone-700{color:#3b463f!important}
    body.sci-page header .text-stone-600{color:#6f6a5c!important}
    body.sci-page header .text-amber-600{color:#8f6524!important}
    body.sci-page header .text-amber-700{color:#2e6f68!important}
    body.sci-page header .bg-amber-600{background:#8f6524!important}
    body.sci-page header .bg-amber-100{background:#e4ede9!important}
    body.sci-page header .from-amber-600{--tw-gradient-from:#8f6524!important}
    body.sci-page header .to-amber-400{--tw-gradient-to:#c9a35f!important}
    body.sci-page header .hover\:text-amber-700:hover{color:#2e6f68!important}
    body.sci-page header .hover\:bg-stone-100:hover{background:#e9e3d4!important}
    body.sci-page footer.bg-stone-900{background:#0b1c17!important;border-top:1px solid rgba(201,163,95,.28)}
    body.sci-page footer .text-amber-400{color:#c9a35f!important}
    body.sci-page footer .text-amber-500{color:#a67a2e!important}
    body.sci-page footer .text-amber-600{color:#a67a2e!important}
    body.sci-page footer .text-amber-300{color:#e6dcc6!important}
    body.sci-page footer .hover\:text-amber-300:hover{color:#f2ead8!important}
    body.sci-page footer .bg-amber-700{background:#2e6f68!important}
    body.sci-page footer .hover\:bg-amber-700:hover{background:#2e6f68!important}
    body.sci-page footer .bg-stone-800{background:#132a23!important}
    body.sci-page footer .text-stone-300{color:#c9bea6!important}
    body.sci-page footer .from-amber-600{--tw-gradient-from:#a67a2e!important}
    body.sci-page footer .to-amber-400{--tw-gradient-to:#c9a35f!important}
    body.sci-page #back-to-top{background:#2e6f68!important}

    /* ================= RESPONSIVE ================= */
    @media (max-width:1023px){
        .sci-layout{grid-template-columns:1fr;gap:2rem}
        .sci-aside{position:static;display:grid;grid-template-columns:1fr 1fr;align-items:start}
        .sci-card-archive{grid-column:1 / -1}
        .sci-hero-main{grid-template-columns:minmax(0,1fr) 240px;gap:1.8rem}
        .sci-portrait img{height:260px}
    }
    @media (max-width:767px){
        .sci-hero-inner{padding-top:1.9rem}
        .sci-platebar{margin-bottom:1.7rem;font-size:9px;letter-spacing:.1em}
        .sci-hero-main{grid-template-columns:1fr;gap:1.6rem;padding-bottom:2rem}
        .sci-hero h1{max-width:none}
        .sci-portrait{order:-1;max-width:300px}
        .sci-portrait img{height:230px}
        .sci-portrait figcaption{font-size:8px}
        .sci-ruler{height:26px}
        .sci-body{padding-top:1.6rem}
        .sci-layout{gap:1.5rem}
        .sci-article{padding:1.2rem 1rem}
        .sci-prose{font-size:.98rem;line-height:1.95}
        .sci-prose p{text-align:right}
        .sci-aside{grid-template-columns:1fr}
        .sci-meta{flex-direction:column;gap:.45rem}
        .sci-foot{align-items:flex-start}
    }
    @media (prefers-reduced-motion:reduce){
        .sci-hero-fig .wheel{animation:none!important}
    }
</style>

<div class="sci" dir="rtl">

    <!-- ================= HERO ================= -->
    <header class="sci-hero">
        <div class="sci-hero-grid"></div>

        <svg class="sci-hero-fig" viewBox="0 0 520 520" aria-hidden="true">
            <g fill="none" stroke="#c9a35f" stroke-width="1">
                <g class="wheel">
                    <circle cx="260" cy="260" r="196" opacity=".5"/>
                    <circle cx="260" cy="260" r="168" opacity=".28"/>
                    <circle cx="260" cy="260" r="44" opacity=".65"/>
                    <circle cx="260" cy="260" r="8" fill="#c9a35f" stroke="none" opacity=".9"/>
                    <g opacity=".7">
                        <path d="M260 64 l-14 24 h28 Z"/>
                        <path d="M398 122 l-24 12 14 24 Z"/>
                        <path d="M456 260 l-24 14 v-28 Z"/>
                        <path d="M398 398 l-14 24 -24 -14 Z"/>
                        <path d="M260 456 l14 -24 h-28 Z"/>
                        <path d="M122 398 l24 -12 -14 -24 Z"/>
                        <path d="M64 260 l24 -14 v28 Z"/>
                        <path d="M122 122 l14 -24 24 14 Z"/>
                    </g>
                    <g opacity=".4">
                        <line x1="260" y1="216" x2="260" y2="304"/>
                        <line x1="216" y1="260" x2="304" y2="260"/>
                        <line x1="229" y1="229" x2="291" y2="291"/>
                        <line x1="229" y1="291" x2="291" y2="229"/>
                    </g>
                </g>
            </g>
        </svg>

        <div class="sci-hero-inner">
            <div class="sci-platebar">
                <span class="lat">PL. 01 / SCIENTIST FILE</span>
                <span>أرشيف علماء الماء · المغرب والأندلس</span>
                <span class="lat">{{ region_label }}</span>
            </div>

            <div class="sci-hero-main">
                <div>
                    <p class="sci-kicker">{{ cat_label }} · ملف علمي</p>
                    <h1>{{ page.name }}</h1>

                    <dl class="sci-meta">
                        {% if page.dates %}
                        <div>
                            <dt>الفترة</dt>
                            <dd>{{ page.dates }}</dd>
                        </div>
                        {% endif %}
                        {% if page.location %}
                        <div>
                            <dt>الموطن</dt>
                            <dd>{{ page.location }}</dd>
                        </div>
                        {% endif %}
                    </dl>

                    {% if page.tags.size > 0 %}
                    <ul class="sci-tags">
                        {% for tag in page.tags limit:4 %}
                        <li>{{ tag }}</li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </div>

                <figure class="sci-portrait">
                    <div class="sci-portrait-frame">
                        <img src="{{ _sci_url }}" alt="{{ page.name }}" fetchpriority="high">
                    </div>
                    <figcaption>
                        <span dir="ltr">PLATE · PORTRAIT</span>
                        <b dir="ltr">FIG. 01</b>
                    </figcaption>
                </figure>
            </div>
        </div>
        <div class="sci-ruler"></div>
    </header>

    <!-- ================= BODY ================= -->
    <div class="sci-body">
        <div class="sci-wrap">

            <div class="sci-crumb">
                <span><a href="/scientists">أرشيف علماء الماء</a> / ملف العلم</span>
                <span dir="ltr">MAGHRIB · ANDALUS · MEDIEVAL WATER SCIENCES</span>
            </div>

            <div class="sci-layout">
                <!-- Main Content -->
                <article class="sci-article">
                    <div class="sci-article-head">
                        <span class="en" dir="ltr">MONOGRAPH · {{ page.slug | default: page.name | slice: 0, 22 }}</span>
                        <span class="ar">السيرة العلمية</span>
                    </div>

                    <div class="sci-prose">
                        {% assign _sci_body = content | strip %}
                        {% if _sci_body != "" %}
                        {{ content }}
                        {% else %}
                        <p class="sci-lede">{{ page.description }}</p>
                        {% endif %}
                    </div>

                    <div class="sci-foot">
                        <a href="/scientists" class="sci-back">
                            <i class="fas fa-arrow-right"></i>
                            <span>العودة إلى قائمة العلماء</span>
                        </a>
                        <span class="sci-end">END OF FILE · PL. 01</span>
                    </div>
                </article>

                <!-- Sidebar -->
                <aside class="sci-aside">
                    <section class="sci-card">
                        <p class="code"><b>DATA</b> · SHEET</p>
                        <h2>بطاقة العلم</h2>
                        <dl class="sci-dl">
                            {% if page.dates %}
                            <div><dt>الفترة</dt><dd>{{ page.dates }}</dd></div>
                            {% endif %}
                            {% if page.location %}
                            <div><dt>الموطن</dt><dd>{{ page.location }}</dd></div>
                            {% endif %}
                            <div><dt>التخصص</dt><dd>{{ cat_label }}</dd></div>
                            <div><dt>الإقليم</dt><dd>{{ region_label }}</dd></div>
                        </dl>
                        {% if page.tags.size > 0 %}
                        <div class="sci-card-tags">
                            {% for tag in page.tags %}
                            <span>{{ tag }}</span>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </section>

                    <section class="sci-card">
                        <p class="code"><b>CROSS</b> · REFERENCE</p>
                        <h2>علماء آخرون</h2>
                        <div class="sci-rel">
                            {% assign other_scientists = site.scientists | where_exp: "s", "s.name != page.name" | sample: 3 %}
                            {% for scientist in other_scientists %}
                            {% assign _rs_key = scientist.image | remove_first: '/' %}
                            <a href="{{ scientist.url }}">
                                <span class="sci-rel-thumb">
                                    <img src="{{ site.data.manifest[_rs_key] | default: scientist.image | default: '/dist/images/scientists/default.jpg' }}" alt="{{ scientist.name }}" loading="lazy">
                                </span>
                                <span>
                                    <b>{{ scientist.name }}</b>
                                    <span>{{ scientist.dates }}</span>
                                </span>
                            </a>
                            {% endfor %}
                        </div>
                    </section>

                    <section class="sci-card sci-card-archive">
                        <p class="code"><b>ARCHIVE</b> · INDEX</p>
                        <h2>أرشيف علماء الماء</h2>
                        <p>فهرس اللوحات، المقياس الزمني، وجداول المواقع في المغرب والأندلس.</p>
                        <a href="/scientists">
                            استعراض اللوحات
                            <i class="fas fa-arrow-left"></i>
                        </a>
                        <span class="stamp">PL. 01–10 · WATER ENGINEERING</span>
                    </section>
                </aside>
            </div>
        </div>
    </div>

</div>

<!-- Structured Data for SEO -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ page.name }}",
    "description": "{{ content | strip_html | truncatewords: 50 }}",
    "image": "{{ site.url }}{{ _sci_url }}",
    "url": "{{ site.url }}{{ page.url }}",
    "birthDate": "{{ page.dates | split: '-' | first | strip }}",
    "jobTitle": "{% case page.category %}{% when 'engineering' %}مهندس مائي{% when 'geography' %}جغرافي{% when 'medicine' %}طبيب{% when 'agriculture' %}عالم زراعة{% else %}عالم{% endcase %}"
}
</script>
