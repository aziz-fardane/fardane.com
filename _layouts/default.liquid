<!DOCTYPE html>
<html lang="{{ page.lang | default: 'ar' }}" dir="{% if page.lang == 'en' %}ltr{% else %}rtl{% endif %}" class="scroll-smooth">
    <head>
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-1H5F625Z31"></script>
        <script>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-1H5F625Z31');
        </script>

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="referrer" content="strict-origin-when-cross-origin">
        <title>{% if page.title %}{{ page.title }} | {% endif %}{% if page.lang == 'en' %}Aziz Fardane{% else %}{{ site.title }}{% endif %}</title>
        <meta name="description" content="{{ page.description | default: site.description }}">
        {% assign _tags_csv = page.tags | join: ', ' | replace: '-', ' ' %}
{% assign _kw = page.keywords %}
{% unless _kw %}
  {% if page.layout == 'post' or page.layout == 'post-feature' %}
    {% assign _kw = page.title | append: ', ' | append: _tags_csv | append: ', تاريخ الماء في المغرب' %}
  {% endif %}
{% endunless %}
<meta name="keywords" content="{{ _kw | default: site.keywords | escape }}">
        <meta name="author" content="{{ site.author }}">

        {% if page.layout == 'post' or page.layout == 'post-feature' or page.layout == 'news' or page.layout == 'news-article' or page.layout == 'publication' or page.layout == 'research' %}
        <!-- Highwire citation metadata for scholarly indexing -->
        <meta name="citation_title" content="{{ page.title | escape }}">
        <meta name="citation_author" content="عزيز فردان">
        <meta name="citation_author_institution" content="Cadi Ayyad University, Marrakech, Morocco">
        <meta name="citation_publication_date" content="{{ page.date | date: '%Y/%m/%d' }}">
        <meta name="citation_language" content="{{ page.lang | default: 'ar' }}">
        <meta name="citation_fulltext_html_url" content="{{ page.url | absolute_url }}">
        {% if page.doi %}<meta name="citation_doi" content="{{ page.doi | escape }}">{% endif %}
        {% if page.pdf %}{% assign _cit_pdf_key = page.pdf | remove_first: '/' %}<meta name="citation_pdf_url" content="{{ site.data.manifest[_cit_pdf_key] | default: page.pdf | absolute_url }}">{% endif %}
        <meta name="citation_author_orcid" content="https://orcid.org/0009-0007-1033-7415">
        {% if page.tags.size > 0 %}<meta name="citation_keywords" content="{{ page.tags | join: ', ' | replace: '-', ' ' | escape }}">{% endif %}
        {% if page.description %}<meta name="citation_abstract" content="{{ page.description | strip_html | truncate: 350 | escape }}">{% endif %}
        {% if page.title_en %}<meta name="DC.title" content="{{ page.title_en | escape }}">{% endif %}
        {% if page.abstract_en %}<meta name="DC.language" content="en">{% endif %}
        {% endif %}

        {% if page.noindex %}
        <meta name="robots" content="noindex, nofollow">
        {% endif %}

        <!-- Favicons -->
        <link rel="icon" href="{{ site.data.manifest['dist/images/favicon.svg'] | default: '/dist/images/favicon.svg' }}" sizes="any">
        <link rel="apple-touch-icon" href="{{ site.data.manifest['dist/images/apple-touch-icon.png'] | default: '/dist/images/apple-touch-icon.png' }}">

        <!-- Arabic fonts — the four families of the identity -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Reem+Kufi:wght@400..700&family=Noto+Kufi+Arabic:wght@100..900&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

        <!-- Font Awesome icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        <!-- Canonical URL -->
        <link rel="canonical" href="{{ page.url | absolute_url }}">

        <!-- Language alternates -->
        {% if page.alt_url %}
        <link rel="alternate" hreflang="{% if page.lang == 'en' %}ar{% else %}en{% endif %}" href="{{ page.alt_url | absolute_url }}">
        <link rel="alternate" hreflang="{% if page.lang == 'en' %}en{% else %}ar{% endif %}" href="{{ page.url | absolute_url }}">
        <link rel="alternate" hreflang="x-default" href="{% if page.lang == 'en' %}{{ page.alt_url | absolute_url }}{% else %}{{ page.url | absolute_url }}{% endif %}">
        {% endif %}

        <!-- Open Graph / Facebook -->
        {% if site.facebook_app_id %}
        <meta property="fb:app_id" content="{{ site.facebook_app_id }}">
        {% endif %}
        <meta property="og:type" content="{% if page.layout == 'post' or page.layout == 'post-feature' or page.layout == 'news' or page.layout == 'news-article' or page.layout == 'scientist' %}article{% else %}website{% endif %}">
        <meta property="og:url" content="{{ page.url | absolute_url }}">
        <meta property="og:title" content="{{ page.title | default: site.title }}">
        <meta property="og:description" content="{{ page.description | default: site.description | strip_html | truncate: 200 }}">
        <meta property="og:site_name" content="{{ site.title }}">
        <meta property="og:locale" content="{% if page.lang == 'en' %}en_GB{% else %}ar_MA{% endif %}">
        {% if page.image %}
        {% assign _og_img_key = page.image | remove_first: '/' %}
        <meta property="og:image" content="{{ site.data.manifest[_og_img_key] | default: page.image | absolute_url }}">
        {% elsif page.thumbnail %}
        {% assign _og_img_key = page.thumbnail | remove_first: '/' %}
        <meta property="og:image" content="{{ site.data.manifest[_og_img_key] | default: page.thumbnail | absolute_url }}">
        {% else %}
        <meta property="og:image" content="{{ site.url }}{{ site.data.manifest['dist/images/profile.jpg'] | default: '/dist/images/profile.jpg' }}">
        {% endif %}
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:url" content="{{ page.url | absolute_url }}">
        <meta name="twitter:title" content="{{ page.title | default: site.title }}">
        <meta name="twitter:description" content="{{ page.description | default: site.description | strip_html | truncate: 200 }}">
        {% if page.image %}
        {% assign _tw_img_key = page.image | remove_first: '/' %}
        <meta name="twitter:image" content="{{ site.data.manifest[_tw_img_key] | default: page.image | absolute_url }}">
        {% elsif page.thumbnail %}
        {% assign _tw_img_key = page.thumbnail | remove_first: '/' %}
        <meta name="twitter:image" content="{{ site.data.manifest[_tw_img_key] | default: page.thumbnail | absolute_url }}">
        {% else %}
        <meta name="twitter:image" content="{{ site.url }}{{ site.data.manifest['dist/images/profile.jpg'] | default: '/dist/images/profile.jpg' }}">
        {% endif %}
        {% if site.twitter.username %}
        <meta name="twitter:site" content="@{{ site.twitter.username }}">
        {% endif %}

        <!-- Structured Data -->
        {% if page.url == "/" or page.url == "/index.html" or page.url == "/about/" %}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "Person",
              "@id": "{{ site.url }}/#person",
              "name": "د. عزيز فردان",
              "alternateName": ["Aziz Fardane", "عزيز فردان"],
              "jobTitle": "باحث مستقل في تاريخ النظم المائية والعمران",
              "alumniOf": {
                "@type": "CollegeOrUniversity",
                "name": "جامعة القاضي عياض",
                "url": "https://www.uca.ma"
              },
              "url": "{{ site.url }}",
              "image": "{{ site.url }}{{ site.data.manifest['dist/images/profile.jpg'] | default: '/dist/images/profile.jpg' }}",
              "sameAs": [
                "https://orcid.org/0009-0007-1033-7415",
                "https://scholar.google.com/citations?user=yDZ8H28AAAAJ",
                "https://zenodo.org/records/24394004",
                "https://www.wikidata.org/wiki/Q142216864",
                "https://independent.academia.edu/azizfardane",
                "https://www.linkedin.com/in/aziz-fardane/"
              ],
              "identifier": {
                "@type": "PropertyValue",
                "propertyID": "ORCID",
                "value": "0009-0007-1033-7415"
              },
              "knowsLanguage": [
                "ar",
                "fr",
                "en"
              ],
              "knowsAbout": [
                "تاريخ المياه",
                "تاريخ الماء في المغرب",
                "تاريخ المغرب الوسيط",
                "حضارة إسلامية",
                "نظم مائية تقليدية",
                "واحات مغربية",
                "طوبونيميا",
                "Water history in Morocco",
                "Historical hydraulics",
                "Histoire de l'eau au Maroc"
              ]
            },
            {
              "@type": "Organization",
              "name": "جامعة القاضي عياض",
              "url": "https://www.uca.ma",
              "logo": "{{ site.url }}{{ site.data.manifest['dist/images/university-logo.png'] | default: '/dist/images/university-logo.png' }}",
              "description": "جامعة القاضي عياض هي جامعة مغربية تقع في مدينة مراكش",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "مراكش",
                "postalCode": "40000",
                "addressCountry": "MA"
              },
              "sameAs": [
                "https://www.uca.ma"
              ]
            },
            {
              "@type": "WebSite",
              "@id": "{{ site.url }}/#website",
              "url": "{{ site.url }}/",
              "name": "تاريخ الماء في المغرب — الدكتور عزيز فردان",
              "alternateName": [
                "Water History in Morocco — Aziz Fardane",
                "Histoire de l'eau au Maroc — Aziz Fardane"
              ],
              "description": "مرجع أكاديمي متخصص في تاريخ الماء والنظم المائية والعمران والمصادر التاريخية في المغرب الوسيط",
              "inLanguage": ["ar", "en", "fr"],
              "publisher": { "@id": "{{ site.url }}/#person" },
              "potentialAction": {
                "@type": "SearchAction",
                "target": "{{ site.url }}/search/?query={search_term_string}",
                "query-input": "required name=search_term_string"
              }
            }
          ]
        }
        </script>
        {% endif %}

        <!-- English section structured data -->
        {% if page.lang == "en" %}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "Person",
              "@id": "{{ site.url }}/en/#person",
              "name": "Aziz Fardane",
              "alternateName": "د. عزيز فردان",
              "jobTitle": "Researcher in the history of the medieval Maghrib — Arabic manuscript sources",
              "url": "{{ site.url }}/en/",
              "image": "{{ site.url }}{{ site.data.manifest['dist/images/profile.jpg'] | default: '/dist/images/profile.jpg' }}",
              "alumniOf": {
                "@type": "CollegeOrUniversity",
                "name": "Cadi Ayyad University",
                "url": "https://www.uca.ma"
              },
              "knowsLanguage": [
                "ar",
                "fr",
                "en"
              ],
              "knowsAbout": [
                "Arabic manuscripts",
                "Medieval Maghrib",
                "Water history",
                "Critical edition",
                "Toponymy",
                "Moroccan archives"
              ],
              "sameAs": [
                "https://orcid.org/0009-0007-1033-7415",
                "https://scholar.google.com/citations?user=yDZ8H28AAAAJ",
                "https://zenodo.org/records/24394004",
                "https://www.wikidata.org/wiki/Q142216864",
                "https://independent.academia.edu/azizfardane",
                "https://www.linkedin.com/in/aziz-fardane/"
              ],
              "identifier": {
                "@type": "PropertyValue",
                "propertyID": "ORCID",
                "value": "0009-0007-1033-7415"
              }
            },
            {
              "@type": "WebPage",
              "@id": "{{ page.url | absolute_url }}",
              "url": "{{ page.url | absolute_url }}",
              "name": "{{ page.title | escape }}",
              "description": "{{ page.description | escape }}",
              "inLanguage": "en",
              "about": {
                "@id": "{{ site.url }}/en/#person"
              }
            }
          ]
        }
        </script>
        {% endif %}

        <!-- NewsArticle Structured Data for News -->
        {% if page.layout == "news-article" or page.layout == "news" %}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "NewsArticle",
          "headline": "{{ page.title | escape }}",
          "description": "{{ page.description | strip_html | truncate: 160 | escape }}",
          {% assign _ld_news_key = page.thumbnail | remove_first: '/' %}
          "image": {
            "@type": "ImageObject",
            "url": "{{ site.data.manifest[_ld_news_key] | default: page.thumbnail | default: '/dist/images/news/default.jpg' | absolute_url }}"
          },
          "datePublished": "{{ page.date | date_to_xmlschema }}",
          "dateModified": "{{ page.last_modified_at | default: page.date | date_to_xmlschema }}",
          "author": {
            "@type": "Person",
            "name": "د. عزيز فردان",
            "url": "{{ site.url }}"
          },
          "publisher": {
            "@type": "Organization",
            "name": "{{ site.title }}",
            "url": "{{ site.url }}",
            "logo": {
              "@type": "ImageObject",
              "url": "{{ site.url }}{{ site.data.manifest['dist/images/university-logo.png'] | default: '/dist/images/university-logo.png' }}"
            }
          },
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ page.url | absolute_url }}"
          },
          "url": "{{ page.url | absolute_url }}",
          "articleSection": "{{ page.type | default: 'إعلان' | escape }}",
          "inLanguage": "ar"
        }
        </script>
        {% endif %}

        <!-- In your layout file -->
        {% if jekyll.environment == "development" %}
          <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
          <meta http-equiv="Pragma" content="no-cache" />
          <meta http-equiv="Expires" content="0" />
        {% else %}
          <!-- Different cache times for different content types -->
          {% if page.layout == "post" or page.layout == "post-feature" or page.layout == "page" %}
            <!-- Content pages get shorter cache times -->
            <meta http-equiv="Cache-Control" content="public, max-age=1800" /> <!-- 30 minutes -->
          {% elsif page.url == "/index.html" or page.url == "/" %}
            <!-- Homepage gets medium cache time -->
            <meta http-equiv="Cache-Control" content="public, max-age=3600" /> <!-- 1 hour -->
          {% else %}
            <!-- Other assets get longer cache times -->
            <meta http-equiv="Cache-Control" content="public, max-age=86400" /> <!-- 24 hours -->
          {% endif %}
        {% endif %}

        <!-- Styles -->
        <link rel="stylesheet" href="{{ site.data.manifest['dist/main.css'] }}"/>

        <!-- RTL support for Tailwind CSS -->
        <style>
            :root {
                --font-family: 'Noto Naskh Arabic', 'Noto Kufi Arabic', system-ui, sans-serif;
            }

            body {
                font-family: var(--font-family);
            }
        </style>

        <!-- Scripts -->
        <script defer src="{{ site.data.manifest['dist/main.js'] }}"></script>
    </head>
    <body class="bg-plaster text-ink min-h-screen flex flex-col{% if page.layout == 'scientist' %} sci-page{% endif %}{% if page.layout == 'post' or page.layout == 'post-feature' %} post-page{% endif %}{% if page.layout == 'post' %} post-edition{% endif %}{% if page.url == '/' %} home-page{% endif %}{% if page.url == '/articles/' %} articles-page{% endif %}">
        <!-- Simple preloader -->
        <div id="preloader" class="fixed inset-0 bg-plaster z-50 flex items-center justify-center">
            <div class="animate-spin w-10 h-10 border-2 border-brass-text border-b-transparent"></div>
        </div>

        <!-- Header -->
        {% if page.lang == "en" %}{% include header-en.liquid %}{% else %}{% include header.liquid %}{% endif %}

        <!-- Main content -->
        <main class="flex-grow">
            {{ content }}
        </main>

        <!-- Newsletter (rendered only when site.newsletter_action is set) -->
        {% unless page.lang == "en" %}{% include newsletter.liquid %}{% endunless %}

        <!-- Footer -->
        {% if page.lang == "en" %}{% include footer-en.liquid %}{% else %}{% include footer.liquid %}{% endif %}

        <!-- Back to top button -->
        <button id="back-to-top"
                aria-label="{% if page.lang == 'en' %}Back to top{% else %}العودة إلى أعلى الصفحة{% endif %}"
                title="{% if page.lang == 'en' %}Back to top{% else %}العودة إلى أعلى الصفحة{% endif %}"
                class="fixed bottom-8 left-8 bg-brass-text text-plaster w-12 h-12 flex items-center justify-center opacity-0 transition-all duration-300 hover:bg-water-ink hover:-translate-y-1">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 19V5M5 12l7-7 7 7"/>
            </svg>
        </button>

        <!-- Facebook SDK for Comments is loaded on demand from the article layout -->

        {% include analytics-events.liquid %}
    </body>
</html>
